  <paper type="A4" orientation="landscape" left-margin="45" right-margin="45" top-margin="48" bottom-margin="48" paging-mode="fitpage" fixrows="3" html-report-align="center" column-enabled="false" html-interval-refresh-value="0"/>
  <datasource name="内置数据源" type="buildin">
    <dataset name="产量数据" type="sql">
      <sql><![CDATA[SELECT wo.work_order_no AS 工单号,
COALESCE(p.product_name, '未关联产品') AS 产品名称,
wo.plan_qty AS 计划数量,
wo.completed_qty AS 完成数量,
(wo.completed_qty - wo.plan_qty) AS 差异,
ROUND(CASE WHEN wo.plan_qty = 0 THEN 0 ELSE wo.completed_qty * 100.0 / wo.plan_qty END, 1) AS 达成率,
CASE wo.status WHEN 'CREATED' THEN '已创建' WHEN 'PREPARE' THEN '待生产' WHEN 'CONFIRMED' THEN '已确认' WHEN 'RELEASED' THEN '已下达' WHEN 'IN_PROGRESS' THEN '生产中' WHEN 'FINISHED' THEN '已完成' WHEN 'COMPLETED' THEN '已完成' WHEN 'CLOSED' THEN '已关闭' ELSE wo.status END AS 状态
FROM work_order wo
LEFT JOIN product p ON wo.product_id = p.product_id
ORDER BY wo.work_order_id DESC LIMIT 50]]></sql>
      <field name="工单号"/><field name="产品名称"/><field name="计划数量"/><field name="完成数量"/><field name="差异"/><field name="达成率"/><field name="状态"/>
    </dataset>
  </datasource>
