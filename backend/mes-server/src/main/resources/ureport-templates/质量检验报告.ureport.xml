  <datasource name="内置数据源" type="buildin">
    <dataset name="质检数据" type="sql">
      <sql><![CDATA[SELECT i.iqc_code AS 检验单号,
CONCAT(COALESCE(i.item_code, ''), ' ', COALESCE(i.item_name, '')) AS 物料,
COALESCE(i.vendor_name, i.vendor_code, '未登记') AS 供应商,
CONCAT(FORMAT(COALESCE(i.quantity_recived,0),2), ' / ', FORMAT(COALESCE(i.quantity_check,0),2)) AS 接收检验,
CONCAT(COALESCE(i.quantity_qualified,0), ' / ', COALESCE(i.quantity_unqualified,0)) AS 合格不合格,
i.quantity_recived AS 接收数量,
i.quantity_qualified AS 合格数量,
i.quantity_unqualified AS 不合格数量,
CASE i.check_result WHEN 'ACCEPT' THEN '合格' WHEN 'PASS' THEN '合格' WHEN 'QUALIFIED' THEN '合格' WHEN 'CONCESSION' THEN '让步接收' WHEN 'REJECT' THEN '不合格' WHEN 'UNQUALIFIED' THEN '不合格' ELSE COALESCE(i.check_result,'待判定') END AS 判定,
i.inspect_date AS 检验日期
FROM qc_iqc i ORDER BY i.iqc_id DESC LIMIT 50]]></sql>
      <field name="检验单号"/><field name="物料"/><field name="供应商"/><field name="接收检验"/><field name="合格不合格"/><field name="接收数量"/><field name="合格数量"/><field name="不合格数量"/><field name="判定"/><field name="检验日期"/>
    </dataset>
  </datasource>
