<page-header title="库存任务" showBack="{{true}}" />

<view class="page-container">
    <view class="it-dir-tabs">
    <view
      class="it-dir-tab {{activeDirection === item.value ? 'it-dir-tab--active' : ''}}"
      wx:for="{{directionTabs}}" wx:key="value"
      data-value="{{item.value}}" bindtap="onDirectionChange"
    >{{item.label}}</view>
  </view>

    <view class="it-tabs it-tabs--sub">
    <view
      class="it-tab {{activeStatus === item.value ? 'it-tab--active' : ''}}"
      wx:for="{{activeDirection === 'INBOUND' ? inboundStatusList : outboundStatusList}}" wx:key="value"
      data-value="{{item.value}}" bindtap="onStatusChange"
    >{{item.label}}</view>
  </view>

    <block wx:if="{{!showOutboundForm}}">
    <view class="it-list">
      <block wx:for="{{taskList}}" wx:key="taskId">
        <view class="it-card" data-task-id="{{item.taskId}}" bindtap="onTaskTap">
          <view class="it-card-top">
            <text class="it-material">{{item.materialName}}</text>
            <status-tag status="{{item.status}}">{{item.statusLabel}}</status-tag>
          </view>

          <view class="it-card-sub">
            <text>{{item.taskNo}}</text>
            <text class="it-sub-div">·</text>
            <text>{{item.materialCode}}</text>
          </view>

                    <block wx:if="{{item.taskType === 'INBOUND'}}">
            <view class="it-info-row">
              <view class="it-info-item">
                <text class="it-info-l">规格</text><text class="it-info-v">{{item.spec || '--'}}</text>
              </view>
              <view class="it-info-item">
                <text class="it-info-l">批次号</text><text class="it-info-v">{{item.batchNo}}</text>
              </view>
              <view class="it-info-item">
                <text class="it-info-l">仓库/库位</text><text class="it-info-v">{{item.warehouseName}} / {{item.locationCode}}</text>
              </view>
              <view class="it-info-item">
                <text class="it-info-l">来源工单</text><text class="it-info-v">{{item.workOrderNo}}</text>
              </view>
            </view>
            <view class="it-progress-row">
              <view class="it-progress-bar">
                <view class="it-progress-fill" style="width:{{item.qty > 0 ? (item.registeredQty || 0) / item.qty * 100 : 0}}%;"></view>
              </view>
              <text class="it-progress-num">{{item.registeredQty || 0}}/{{item.qty}} {{item.unit || ''}}</text>
            </view>
          </block>

                    <block wx:if="{{item.taskType === 'OUTBOUND'}}">
            <view class="it-info-row">
              <view class="it-info-item">
                <text class="it-info-l">规格</text><text class="it-info-v">{{item.spec || '--'}}</text>
              </view>
              <view class="it-info-item">
                <text class="it-info-l">出库数量</text><text class="it-info-v it-info-hl">{{item.qty}} {{item.unit || ''}}</text>
              </view>
              <view class="it-info-item">
                <text class="it-info-l">去向</text><text class="it-info-v">{{item.destination || '--'}}</text>
              </view>
              <view class="it-info-item">
                <text class="it-info-l">领用人</text><text class="it-info-v">{{item.recipient || '--'}}</text>
              </view>
            </view>
          </block>

          <view class="it-card-foot">
            <text class="it-time">{{item.createTimeStr}}</text>
            <text class="it-arrow">›</text>
          </view>
        </view>
      </block>
    </view>

        <view class="it-empty" wx:if="{{!loading && taskList.length === 0}}">
      <text class="it-empty-icon">📦</text>
      <text class="it-empty-title">暂无{{activeDirection === 'INBOUND' ? '入库' : '出库'}}任务</text>
    </view>

        <view wx:if="{{activeDirection === 'OUTBOUND'}}" class="it-fab" bindtap="onToggleOutboundForm">
      <text class="it-fab-text">+ 新建出库</text>
    </view>
  </block>

    <block wx:if="{{showOutboundForm}}">
    <view class="ob-form-header">
      <view class="ob-form-back" bindtap="onToggleOutboundForm">← 返回</view>
      <text class="ob-form-title">新建出库单</text>
      <view></view>
    </view>

    <scroll-view class="ob-form-body" scroll-y enhanced show-scrollbar="{{false}}">
            <view class="ob-form-section">
        <text class="ob-section-title">物料信息</text>
        <view class="ob-scan-row">
          <input class="ob-input" placeholder="搜索或输入物料编码/名称" value="{{outboundForm.materialCode}}" bindinput="onOutboundMaterialSearch" bindconfirm="onOutboundMaterialSearchConfirm" />
          <view class="ob-scan-btn" bindtap="onScanMaterial">
            <image class="ob-scan-icon" src="/images/扫码_scan-code.svg" mode="aspectFit" />
          </view>
        </view>
        <block wx:if="{{outboundForm.materialName}}">
          <view class="ob-info-row"><text class="ob-info-label">物料名称：</text><text>{{outboundForm.materialName}}</text></view>
          <view class="ob-info-row"><text class="ob-info-label">规格：</text><text>{{outboundForm.spec}}</text></view>
          <view class="ob-info-row"><text class="ob-info-label">批次号：</text><text>{{outboundForm.batchNo}}</text></view>
        </block>
        <view class="ob-warn" wx:if="{{!outboundForm.materialName && outboundForm.materialCode}}">未找到该物料，请检查输入或使用扫码</view>
      </view>

            <view class="ob-form-section">
        <text class="ob-section-title">出库数量</text>
        <view class="ob-stepper">
          <view class="ob-step-btn" bindtap="onOutboundQtyChange" data-delta="-1">−</view>
          <input class="ob-step-input" type="number" value="{{outboundForm.outboundQty}}" bindinput="onOutboundQtyInput" />
          <view class="ob-step-btn" bindtap="onOutboundQtyChange" data-delta="1">+</view>
        </view>
      </view>

            <view class="ob-form-section">
        <text class="ob-section-title">去向</text>
        <picker mode="selector" range="{{destinationOptions}}" value="{{destinationIndex}}" bindchange="onDestinationChange">
          <view class="ob-picker {{outboundForm.destination ? '' : 'ob-picker--placeholder'}}">
            {{outboundForm.destination || '请选择去向'}}
            <text class="ob-picker-arrow">›</text>
          </view>
        </picker>
      </view>

            <view class="ob-form-section">
        <text class="ob-section-title">领用人</text>
        <input class="ob-input" placeholder="输入领用人姓名" value="{{outboundForm.recipient}}" bindinput="onRecipientInput" />
      </view>

            <view class="ob-form-section">
        <text class="ob-section-title">备注（选填）</text>
        <textarea class="ob-textarea" placeholder="备注信息" value="{{outboundForm.notes}}" bindinput="onNotesInput" maxlength="200" />
      </view>

            <view class="ob-submit-btn {{submittingOutbound ? 'ob-submit--loading' : ''}}" bindtap="onSubmitOutbound">
        {{submittingOutbound ? '提交中...' : '确认出库'}}
      </view>
    </scroll-view>
  </block>
</view>
