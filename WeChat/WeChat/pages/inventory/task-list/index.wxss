

.page-container { min-height: 100vh; background: #0A1628; }

.it-dir-tabs { display: flex; padding: 24rpx 32rpx 0; background: rgba(255,255,255,0.04); }
.it-dir-tab {
  flex: 1; text-align: center; padding: 18rpx 0;
  font-size: 28rpx; color: rgba(255,255,255,0.35); border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}
.it-dir-tab--active { font-weight: 700; color: #00B4E4; border-bottom-color: #00B4E4; }

.it-tabs { display: flex; padding: 24rpx 32rpx 0; background: rgba(255,255,255,0.04); }
.it-tabs--sub { padding-top: 12rpx; padding-bottom: 24rpx; }
.it-tab {
  flex: 1; text-align: center; padding: 18rpx 0;
  font-size: 24rpx; color: rgba(255,255,255,0.35); border-bottom: 4rpx solid transparent;
}
.it-tab--active { font-weight: 700; color: #00B4E4; border-bottom-color: #00B4E4; }

.it-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.it-card {
  background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.it-card:active { transform: scale(0.98); }

.it-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.it-material { font-size: 32rpx; font-weight: 700; color: #E2E8F0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 24rpx; }

.it-card-sub { display: flex; gap: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.25); margin-bottom: 16rpx; }
.it-sub-div { color: rgba(255,255,255,0.10); }

.it-info-row { display: flex; flex-wrap: wrap; margin-bottom: 16rpx; }
.it-info-item { width: 50%; padding: 6rpx 0; }
.it-info-item:nth-child(odd) { padding-right: 24rpx; }
.it-info-l { font-size: 22rpx; color: rgba(255,255,255,0.35); display: block; }
.it-info-v { font-size: 24rpx; font-weight: 500; color: #E2E8F0; }
.it-info-hl { color: #00B4E4; font-weight: 600; }

.it-progress-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.it-progress-bar { flex: 1; height: 8rpx; background: rgba(255,255,255,0.06); border-radius: 4rpx; overflow: hidden; }
.it-progress-fill { height: 100%; background: #00E896; border-radius: 4rpx; }
.it-progress-num { font-size: 24rpx; font-weight: 600; color: #00B4E4; font-family: var(--font-mono); }

.it-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 20rpx; border-top: 1px dashed rgba(255,255,255,0.08); }
.it-time { font-size: 24rpx; color: rgba(255,255,255,0.25); }
.it-arrow { font-size: 32rpx; color: rgba(255,255,255,0.18); font-weight: 300; }

.it-empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.it-empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.it-empty-title { font-size: 32rpx; font-weight: 700; color: #E2E8F0; margin-bottom: 8rpx; }
.it-empty-desc { font-size: 24rpx; color: rgba(255,255,255,0.25); }

.it-fab {
  position: fixed; bottom: calc(48rpx + env(safe-area-inset-bottom));
  left: 32rpx; right: 32rpx; height: 96rpx;
  background: #00B4E4; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26,58,92,0.25);
  z-index: 10;
}
.it-fab:active { opacity: 0.9; transform: scale(0.98); }
.it-fab-text { color: #fff; font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; }

.ob-form-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--color-card-solid);
  border-bottom: 1rpx solid var(--color-divider);
}
.ob-form-back { font-size: 28rpx; color: var(--color-primary); }
.ob-form-title { font-size: 30rpx; font-weight: 700; color: var(--color-text); }
.ob-form-body {
  height: calc(100vh - 120rpx);
  padding: 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.ob-form-section {
  background: var(--color-card); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md); padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.ob-section-title {
  font-size: 28rpx; font-weight: 700; color: var(--color-text);
  margin-bottom: 20rpx; display: block;
}

.ob-scan-row { display: flex; gap: 12rpx; }
.ob-input {
  flex: 1; height: 80rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; color: var(--color-text);
}
.ob-scan-btn {
  width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
}
.ob-scan-btn:active { background: var(--color-card-hover); }
.ob-scan-icon { width: 40rpx; height: 40rpx; }

.ob-info-row { font-size: 26rpx; color: var(--color-text); padding: 8rpx 0; }
.ob-info-label { color: var(--color-text-placeholder); }
.ob-warn {
  margin-top: 16rpx; padding: 16rpx;
  background: var(--color-danger-light); border-radius: 8rpx;
  font-size: 24rpx; color: var(--color-danger);
}

.ob-stepper { display: flex; align-items: center; }
.ob-step-btn {
  width: 88rpx; height: 88rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; color: var(--color-text);
}
.ob-step-btn:active { background: var(--color-card-hover); }
.ob-step-input {
  width: 160rpx; height: 88rpx; margin: 0 16rpx;
  background: rgba(255,255,255,0.06); border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 16rpx; text-align: center;
  font-size: 36rpx; font-weight: 700; color: var(--color-text);
}

.ob-picker {
  display: flex; align-items: center; justify-content: space-between;
  height: 80rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; color: var(--color-text);
}
.ob-picker--placeholder { color: var(--color-text-placeholder); }
.ob-picker-arrow { font-size: 32rpx; color: var(--color-text-placeholder); }

.ob-textarea {
  width: 100%; height: 150rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  border-radius: 12rpx; padding: 24rpx; font-size: 26rpx; color: var(--color-text);
  box-sizing: border-box;
}

.ob-submit-btn {
  height: 96rpx; border-radius: 24rpx;
  background: var(--gradient-primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx;
  margin-bottom: 32rpx;
}
.ob-submit-btn:active { opacity: 0.88; transform: scale(0.98); }
.ob-submit--loading { opacity: 0.6; pointer-events: none; }
