<page-header title="退料详情" showBack="{{true}}" />

<view class="page-container">
  <block wx:if="{{!loading && task}}">
    <view class="rd-content">

            <view class="rd-card">
        <view class="rd-status-row">
          <text class="rd-status-label">退料状态</text>
          <status-tag status="{{task.status}}">{{task.statusLabel}}</status-tag>
        </view>
      </view>

            <view class="rd-card">
        <text class="rd-section-title">物料信息</text>
        <view class="rd-info-grid">
          <view class="rd-info-item">
            <text class="rd-info-l">物料编码</text>
            <text class="rd-info-v">{{task.materialCode || '--'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">物料名称</text>
            <text class="rd-info-v rd-info-highlight">{{task.materialName || '--'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">规格型号</text>
            <text class="rd-info-v">{{task.spec || '--'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">批次号</text>
            <text class="rd-info-v">{{task.batchNo || '--'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">退料数量</text>
            <text class="rd-info-v rd-info-highlight">{{task.qty}} {{task.unit || '个'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">仓库 / 库位</text>
            <text class="rd-info-v">{{task.warehouseName || '--'}} · {{task.locationCode || '--'}}</text>
          </view>
        </view>
      </view>

            <view class="rd-card">
        <text class="rd-section-title">退料原因</text>
        <view class="rd-reason">
          <text>{{task.reason || '--'}}</text>
        </view>
      </view>

            <view class="rd-card">
        <text class="rd-section-title">操作信息</text>
        <view class="rd-info-grid">
          <view class="rd-info-item">
            <text class="rd-info-l">退料人</text>
            <text class="rd-info-v">{{task.createdBy || '--'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">处理人</text>
            <text class="rd-info-v">{{task.assignedTo || '--'}}</text>
          </view>
          <view class="rd-info-item">
            <text class="rd-info-l">创建时间</text>
            <text class="rd-info-v">{{task.createTime}}</text>
          </view>
          <view class="rd-info-item" wx:if="{{task.updateTime}}">
            <text class="rd-info-l">更新时间</text>
            <text class="rd-info-v">{{task.updateTime}}</text>
          </view>
        </view>
      </view>

    </view>
  </block>

  <view class="rd-empty" wx:if="{{!loading && !task}}">
    <text class="rd-empty-icon">📋</text>
    <text class="rd-empty-text">未找到退料单</text>
  </view>
</view>
