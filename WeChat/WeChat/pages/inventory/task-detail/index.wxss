

.page-container { min-height: 100vh; background: var(--color-bg); }
.id-loading, .id-empty { display: flex; justify-content: center; padding: 120rpx; font-size: 28rpx; color: var(--color-text-placeholder); }
.id-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.id-card { background: var(--color-card); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); padding: 32rpx; }
.id-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.id-card-title { font-size: 28rpx; font-weight: 700; color: var(--color-text); margin-bottom: 24rpx; display: block; }
.id-card-head .id-card-title { margin-bottom: 0; }

.id-info-grid { display: flex; flex-wrap: wrap; }
.id-info-item { width: 50%; padding: 10rpx 0; }
.id-info-item:nth-child(odd) { padding-right: 24rpx; }
.id-info-item:nth-child(n+3) { border-top: 1px dashed var(--color-divider); }
.id-info-l { font-size: 24rpx; color: var(--color-text-placeholder); display: block; margin-bottom: 4rpx; }
.id-info-v { font-size: 26rpx; font-weight: 500; color: var(--color-text); }
.id-info-hl { color: var(--color-primary); font-weight: 600; }
.id-info-bad { color: var(--color-danger); font-weight: 600; }

.id-scan-row { display: flex; gap: 16rpx; }
.id-input {
  flex: 1; height: 80rpx; background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; color: var(--color-text);
}
.id-scan-btn {
  width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center; font-size: 36rpx;
}
.id-scan-icon { width: 40rpx; height: 40rpx; }

.id-scanned { margin-top: 24rpx; padding: 24rpx; background: rgba(255,255,255,0.03); border-radius: 12rpx; }

.id-warn {
  margin-top: 20rpx; padding: 20rpx 24rpx; background: var(--color-danger-light);
  border: 1rpx solid rgba(255,71,87,0.15); border-radius: 10rpx;
  font-size: 24rpx; color: var(--color-danger);
}
.id-warn--fifo {
  background: var(--color-warning-light); border-color: rgba(255,184,0,0.15);
  color: var(--color-warning);
}

.id-form-item { margin-top: 24rpx; }
.id-label { font-size: 26rpx; color: var(--color-text-placeholder); display: block; margin-bottom: 12rpx; }

.id-stepper { display: flex; align-items: center; }
.id-step-btn {
  width: 88rpx; height: 88rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; color: var(--color-text);
}
.id-step-btn:active { background: var(--color-card-hover); }
.id-step-input {
  width: 160rpx; height: 88rpx; margin: 0 16rpx;
  background: rgba(255,255,255,0.06); border: 1rpx solid rgba(255,255,255,0.1); border-radius: 16rpx;
  text-align: center; font-size: 36rpx; font-weight: 700; color: var(--color-text);
}
.id-qty-hint { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--color-text-placeholder); }

.id-textarea {
  width: 100%; height: 150rpx; background: rgba(255,255,255,0.05); border: 1rpx solid var(--color-border);
  border-radius: 12rpx; padding: 24rpx; font-size: 26rpx; color: var(--color-text); box-sizing: border-box;
}

.id-btn--loading { opacity: 0.6; pointer-events: none; }

.id-btn-submit {
  height: 96rpx; border-radius: 24rpx;
  background: var(--gradient-primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx;
  margin-top: 24rpx;
}
.id-btn-submit:active { opacity: 0.88; transform: scale(0.98); }
.id-btn--return { background: #D32F2F; }

.id-required { color: var(--color-danger); }

.id-return-toggle {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx; border-radius: var(--radius-md);
  background: rgba(255,71,87,0.05); border: 1rpx dashed rgba(255,71,87,0.2);
  font-size: 26rpx; color: var(--color-text-placeholder);
}
.id-return-toggle:active { background: rgba(255,71,87,0.1); }
.id-return-form { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-divider); }

.id-photo-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.id-photo-item {
  position: relative; width: 150rpx; height: 150rpx;
  border-radius: var(--radius-sm); overflow: hidden; border: 1rpx solid var(--color-border);
}
.id-photo-thumb { width: 100%; height: 100%; }
.id-photo-del {
  position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx;
  background: rgba(0,0,0,0.55); color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 0 var(--radius-sm) 0 var(--radius-sm);
}
.id-photo-add {
  width: 150rpx; height: 150rpx;
  border: 2rpx dashed var(--color-border); border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.02);
}
.id-photo-add:active { border-color: var(--color-primary); }
.id-photo-add-icon { font-size: 48rpx; color: var(--color-text-placeholder); }

.id-return-cancel {
  text-align: center; padding: 16rpx; margin-top: 12rpx;
  font-size: 26rpx; color: var(--color-text-placeholder);
}

.id-inbound-info {
  background: rgba(255,255,255,0.03); border-radius: var(--radius-sm);
  padding: 20rpx 24rpx; margin-bottom: 24rpx;
}
.id-inbound-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10rpx 0;
}
.id-inbound-row + .id-inbound-row { border-top: 1rpx dashed var(--color-divider); }
.id-inbound-row--remain { margin-top: 4rpx; padding-top: 14rpx; border-top-style: solid; }
.id-inbound-label { font-size: 26rpx; color: var(--color-text-placeholder); }
.id-inbound-total { font-size: 26rpx; font-weight: 600; color: var(--color-text); }
.id-inbound-done { font-size: 26rpx; font-weight: 600; color: var(--color-primary); }
.id-inbound-remain { font-size: 30rpx; font-weight: 700; color: var(--color-warning); }

.id-completed-badge {
  display: flex; flex-direction: column; align-items: center; gap: 10rpx;
  padding: 32rpx 0;
}
.id-completed-icon {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(0,232,150,0.1); border: 2rpx solid var(--color-success);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--color-success);
}
.id-completed-text { font-size: 28rpx; font-weight: 700; color: var(--color-success); }
.id-completed-detail { font-size: 24rpx; color: var(--color-text-placeholder); }
