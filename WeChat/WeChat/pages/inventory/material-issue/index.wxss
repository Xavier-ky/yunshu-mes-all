.page-container { min-height: 100vh; background: #0A1628; }

.mi-tabs { display: flex; padding: 16rpx 32rpx; gap: 0; background: rgba(255,255,255,0.03); }
.mi-tab {
  flex: 1; text-align: center; padding: 18rpx 0;
  font-size: 28rpx; font-weight: 500; color: rgba(255,255,255,0.35);
  border-bottom: 4rpx solid transparent; transition: all 0.2s;
}
.mi-tab--active { color: #00B4E4; font-weight: 700; border-bottom-color: #00B4E4; }

.mi-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.mi-card {
  background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  transition: all 0.15s ease;
}
.mi-card:active { transform: scale(0.98); }

.mi-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.mi-material { font-size: 32rpx; font-weight: 700; color: #E2E8F0; }

.mi-card-sub { display: flex; gap: 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.25); margin-bottom: 16rpx; }
.mi-sub-div { color: rgba(255,255,255,0.10); }

.mi-info-row { display: flex; flex-wrap: wrap; margin-bottom: 16rpx; }
.mi-info-item { width: 50%; padding: 8rpx 0; }
.mi-info-item:nth-child(odd) { padding-right: 24rpx; }
.mi-info-l { font-size: 22rpx; color: rgba(255,255,255,0.35); display: block; }
.mi-info-v { font-size: 24rpx; font-weight: 500; color: #E2E8F0; }

.mi-progress-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.mi-progress-bar { flex: 1; height: 8rpx; background: rgba(255,255,255,0.06); border-radius: 4rpx; overflow: hidden; }
.mi-progress-fill { height: 100%; background: #00E896; border-radius: 4rpx; }
.mi-progress-num { font-size: 24rpx; font-weight: 600; color: #00B4E4; font-family: var(--font-mono); }

.mi-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 20rpx; border-top: 1px dashed rgba(255,255,255,0.08); }
.mi-time { font-size: 24rpx; color: rgba(255,255,255,0.25); }
.mi-arrow { font-size: 32rpx; color: rgba(255,255,255,0.18); font-weight: 300; }

.mi-empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.mi-empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.mi-empty-title { font-size: 32rpx; font-weight: 700; color: #E2E8F0; }

.mi-reason { padding: 12rpx 0 8rpx; font-size: 24rpx; color: rgba(255,255,255,0.5); }
.mi-reason-label { color: rgba(255,255,255,0.3); }

.mi-fab { margin-top: 24rpx; text-align: center; }
.mi-fab-text {
  display: inline-block; padding: 16rpx 48rpx;
  background: var(--gradient-primary); color: #fff;
  border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}

.mr-overlay {
  position: fixed; inset: 0; z-index: 100;
  background: var(--color-bg);
  display: flex; flex-direction: column;
}
.mr-form-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.mr-form-back { font-size: 28rpx; color: var(--color-text-secondary); padding: 8rpx; }
.mr-form-title { font-size: 32rpx; font-weight: 700; color: var(--color-text); }
.mr-form-body { flex: 1; overflow-y: auto; padding: 24rpx 28rpx; }
.mr-f-group { margin-bottom: 20rpx; }
.mr-f-label { font-size: 26rpx; color: var(--color-text-secondary); display: block; margin-bottom: 8rpx; }
.mr-f-input {
  height: 80rpx; width: 100%; padding: 0 20rpx;
  background: rgba(255,255,255,0.03); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md); font-size: var(--font-md); color: var(--color-text);
}
.mr-f-row { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.mr-f-half { flex: 1; }
.mr-f-textarea {
  width: 100%; min-height: 140rpx; padding: 14rpx 20rpx;
  background: rgba(255,255,255,0.03); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md); font-size: var(--font-md); color: var(--color-text);
  line-height: 1.6;
}
.mr-submit {
  width: 100%; height: 88rpx; margin-top: 24rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx; background: var(--gradient-primary);
  color: #fff; font-size: 30rpx; font-weight: 700; border: none;
}
