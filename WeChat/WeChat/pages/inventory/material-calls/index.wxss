.page-container { min-height: 100vh; background: #0A1628; }

.filter-tabs {
  display: flex; padding: 24rpx 32rpx 0; background: rgba(255,255,255,0.04);
}
.filter-tab {
  flex: 1; text-align: center; padding: 20rpx 0;
  font-size: 26rpx; color: rgba(255,255,255,0.35); border-bottom: 4rpx solid transparent;
}
.filter-tab--active { font-weight: 700; color: #00B4E4; border-bottom-color: #00B4E4; }

.call-list { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.call-card {
  background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.call-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.call-material { font-size: 32rpx; font-weight: 700; color: #E2E8F0; }
.call-status { font-size: 22rpx; font-weight: 600; padding: 6rpx 16rpx; border-radius: 8rpx; border: 1rpx solid; }
.status-PENDING { color: #FFB800; background: rgba(212,175,55,0.08); border-color: rgba(212,175,55,0.2); }
.status-PROCESSING { color: #00E896; background: rgba(46,139,139,0.08); border-color: rgba(46,139,139,0.2); }
.status-COMPLETED { color: #00E896; background: rgba(46,139,139,0.05); border-color: rgba(46,139,139,0.12); }
.status-UPGRADED { color: #FF4757; background: rgba(255,71,87,0.08); border-color: rgba(211,47,47,0.2); }
.call-card-sub { font-size: 24rpx; color: rgba(255,255,255,0.25); margin-bottom: 12rpx; }
.call-card-row { display: flex; align-items: center; gap: 16rpx; }
.call-qty { font-size: 24rpx; font-weight: 600; color: #00B4E4; }
.call-urgent { font-size: 22rpx; font-weight: 600; color: #FF4757; background: rgba(255,71,87,0.08); padding: 4rpx 14rpx; border-radius: 8rpx; }
.call-time { font-size: 22rpx; color: rgba(255,255,255,0.25); margin-left: auto; }

.empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: #E2E8F0; }
