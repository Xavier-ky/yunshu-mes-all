.page-container { min-height: 100vh; background: #0A1628; }
.md-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 32rpx; }

.md-card { background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); }
.md-section-title { font-size: 28rpx; font-weight: 700; color: #E2E8F0; margin-bottom: 24rpx; display: block; }

.md-status-row { display: flex; justify-content: space-between; align-items: center; }
.md-status-label { font-size: 28rpx; font-weight: 600; color: #E2E8F0; }
.md-status-tag { font-size: 22rpx; font-weight: 600; padding: 6rpx 16rpx; border-radius: 8rpx; border: 1rpx solid; }
.status-PENDING { color: #FFB800; background: rgba(212,175,55,0.08); border-color: rgba(212,175,55,0.2); }
.status-PROCESSING { color: #00E896; background: rgba(46,139,139,0.08); border-color: rgba(46,139,139,0.2); }
.status-COMPLETED { color: #00E896; background: rgba(46,139,139,0.05); border-color: rgba(46,139,139,0.12); }
.status-UPGRADED { color: #FF4757; background: rgba(255,71,87,0.08); border-color: rgba(211,47,47,0.2); }

.md-info-grid { display: flex; flex-wrap: wrap; }
.md-info-item { width: 50%; padding: 12rpx 0; }
.md-info-item:nth-child(odd) { padding-right: 24rpx; }
.md-info-item:nth-child(n+3) { border-top: 1px dashed rgba(255,255,255,0.08); }
.md-info-l { font-size: 24rpx; color: rgba(255,255,255,0.35); display: block; margin-bottom: 4rpx; }
.md-info-v { font-size: 26rpx; font-weight: 500; color: #E2E8F0; }
.md-info-highlight { color: #00B4E4; font-weight: 600; }
.md-remark { margin-top: 16rpx; padding-top: 16rpx; border-top: 1px dashed rgba(255,255,255,0.08); }

.md-form-item { margin-bottom: 28rpx; }
.md-form-item:last-child { margin-bottom: 0; }
.md-label { font-size: 26rpx; color: rgba(255,255,255,0.35); display: block; margin-bottom: 12rpx; }
.md-input {
  width: 100%; height: 80rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; color: #E2E8F0; box-sizing: border-box;
}

.md-actions { margin-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.md-btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 600;
}
.md-btn-primary { background: #00B4E4; color: #fff; }
.md-btn-success { background: #00E896; color: #fff; }
.md-btn-sm { height: 64rpx; font-size: 24rpx; padding: 0 24rpx; background: rgba(255,255,255,0.05); color: #00B4E4; border: 1rpx solid rgba(255,255,255,0.08); border-radius: 12rpx; width: auto; display: inline-flex; }
.md-btn:active { opacity: 0.85; }

.md-upgraded { display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; color: #FF4757; }
