.page-container { min-height: 100vh; background: #0A1628; }

.mr-empty { display: flex; flex-direction: column; align-items: center; padding: 160rpx 60rpx; }
.mr-empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.mr-empty-title { font-size: 32rpx; font-weight: 700; color: #E2E8F0; margin-bottom: 12rpx; }
.mr-empty-desc { font-size: 26rpx; color: rgba(255,255,255,0.35); text-align: center; line-height: 1.6; margin-bottom: 40rpx; }

.mr-goto-btn {
  padding: 20rpx 60rpx; background: #00B4E4; color: #fff;
  border-radius: 12rpx; font-size: 28rpx; font-weight: 600;
}
.mr-goto-btn:active { opacity: 0.85; }
