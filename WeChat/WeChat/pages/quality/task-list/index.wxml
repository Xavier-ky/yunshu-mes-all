<page-header title="质检任务" showBack="{{true}}" />

<view class="page-container">
    <view class="filter-tabs">
    <view
      class="filter-tab {{activeType === item.value ? 'filter-tab--active' : ''}}"
      wx:for="{{typeList}}" wx:key="value"
      data-value="{{item.value}}" bindtap="onTypeChange"
    >{{item.label}}</view>
  </view>

    <view class="filter-tabs filter-tabs--sub">
    <view
      class="filter-tab {{activeStatus === item.value ? 'filter-tab--active' : ''}}"
      wx:for="{{statusList}}" wx:key="value"
      data-value="{{item.value}}" bindtap="onStatusChange"
    >{{item.label}}</view>
  </view>

    <view class="task-list">
    <block wx:for="{{taskList}}" wx:key="taskId">
      <view class="qt-card" data-task-id="{{item.taskId}}" bindtap="onTaskTap">
                <view class="qt-card-top">
          <text class="qt-product">{{item.productName}}</text>
          <view class="qt-status-tag status-{{item.status}} {{item.status === 'ABNORMAL' ? 'status-flash' : ''}}">
            {{item.statusLabel}}
          </view>
        </view>

                <view class="qt-card-sub">
          <text class="qt-sub-item">{{item.inspectionTypeName}}</text>
          <text class="qt-sub-divider">·</text>
          <text class="qt-sub-item">{{item.workOrderNo}}</text>
          <text class="qt-sub-divider">·</text>
          <text class="qt-sub-item">{{item.workstationName}}</text>
        </view>

                <view class="qt-card-meta" wx:if="{{item.productModel || item.productSn}}">
          <text wx:if="{{item.productModel}}" class="qt-meta-item">{{item.productModel}}</text>
          <text wx:if="{{item.productSn}}" class="qt-meta-item">SN: {{item.productSn}}</text>
        </view>

                <view class="qt-progress-row" wx:if="{{item.planQty > 0}}">
          <view class="qt-progress-bar">
            <view class="qt-progress-fill" style="width: {{(item.completedQty || 0) / item.planQty * 100}}%;"></view>
          </view>
          <text class="qt-progress-num">{{item.completedQty || 0}}/{{item.planQty}} 件</text>
        </view>
      </view>
    </block>
  </view>

    <view class="empty-wrap" wx:if="{{!loading && taskList.length === 0}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-title">暂无质检任务</text>
    <text class="empty-desc">当前筛选条件下没有任务，试试切换其他筛选条件</text>
  </view>
</view>
