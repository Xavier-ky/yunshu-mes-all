<page-header title="质检执行" showBack="{{true}}" />

<view class="page-container">
  <view class="qi-loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="qi-empty" wx:elif="{{!taskDetail}}">
    <text>任务不存在</text>
  </view>

  <view class="qi-content" wx:else>
        <view class="qi-card">
      <view class="qi-card-head">
        <text class="qi-card-title">{{taskDetail.inspectionTypeName}}</text>
        <status-tag status="{{taskDetail.status}}">{{taskDetail.statusLabel}}</status-tag>
      </view>
      <view class="qi-info-grid">
        <view class="qi-info-item"><text class="qi-info-l">工单号</text><text class="qi-info-v">{{taskDetail.workOrderNo}}</text></view>
        <view class="qi-info-item"><text class="qi-info-l">产品名称</text><text class="qi-info-v">{{taskDetail.productName}}</text></view>
        <view class="qi-info-item"><text class="qi-info-l">产品型号</text><text class="qi-info-v">{{taskDetail.productModel}}</text></view>
        <view class="qi-info-item"><text class="qi-info-l">产品 SN</text><text class="qi-info-v">{{taskDetail.productSn}}</text></view>
        <view class="qi-info-item"><text class="qi-info-l">工序/工位</text><text class="qi-info-v">{{taskDetail.workstationName}}</text></view>
        <view class="qi-info-item"><text class="qi-info-l">产线</text><text class="qi-info-v">{{taskDetail.lineName}}</text></view>
      </view>
    </view>

        <view class="qi-card" wx:if="{{checklist.length > 0}}">
      <text class="qi-card-title">检验标准</text>
      <view class="qi-checklist">
        <view
          class="qi-check-item"
          wx:for="{{checklist}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="onCheckItem"
        >
          <view class="qi-check-box {{item.checked ? 'qi-checked' : ''}}">
            <text wx:if="{{item.checked}}">✓</text>
          </view>
          <view class="qi-check-body">
            <text class="qi-check-name">{{item.itemName}}</text>
            <text class="qi-check-std">{{item.standard}}</text>
          </view>
        </view>
      </view>
    </view>

        <view class="qi-card">
      <text class="qi-card-title">产品 SN 确认</text>
      <view class="qi-scan-row">
        <input class="qi-input" placeholder="扫描或输入产品SN码" value="{{productSn}}" bindinput="onProductSnInput" />
        <view class="qi-scan-btn" bindtap="onProductSnScan">
          <image class="qi-scan-icon" src="/images/扫码_scan-code.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

        <view class="qi-card">
      <text class="qi-card-title">检验数量</text>

      <view class="qi-form-item">
        <text class="qi-label">抽检数量 <text class="qi-required">*</text></text>
        <input class="qi-input" type="number" placeholder="输入抽检总数" value="{{sampleQty}}" bindinput="onSampleQtyInput" />
      </view>

      <view class="qi-form-item">
        <text class="qi-label">合格数量 <text class="qi-required">*</text></text>
        <view class="qi-stepper">
          <view class="qi-step-btn" bindtap="onGoodQtyChange" data-delta="-1">−</view>
          <input class="qi-step-input" type="number" value="{{goodQty}}" bindinput="onGoodQtyInput" />
          <view class="qi-step-btn" bindtap="onGoodQtyChange" data-delta="1">+</view>
        </view>
      </view>

      <view class="qi-calc-row">
        <text class="qi-calc-label">不良数量</text>
        <text class="qi-calc-val {{defectAuto > 0 ? 'qi-calc-bad' : ''}}">{{defectAuto}} 件</text>
        <text class="qi-calc-hint">（抽检 {{sampleQty || 0}} − 合格 {{goodQty || 0}}）</text>
      </view>
    </view>

        <view class="qi-card" wx:if="{{defectAuto > 0}}">
      <view class="qi-card-head">
        <text class="qi-card-title">缺陷登记</text>
        <view class="qi-add-btn" bindtap="onAddDefect">+ 添加</view>
      </view>

      <text class="qi-empty-hint" wx:if="{{defects.length === 0}}">请至少添加一条缺陷记录</text>

      <view class="qi-defect-item" wx:for="{{defects}}" wx:key="index" wx:for-index="idx">
        <view class="qi-defect-head">
          <text class="qi-defect-num">缺陷 #{{idx + 1}}</text>
          <text class="qi-defect-del" data-index="{{idx}}" bindtap="onRemoveDefect">删除</text>
        </view>

        <view class="qi-form-item">
          <text class="qi-label">缺陷类型 <text class="qi-required">*</text></text>
          <picker mode="selector" range="{{defectTypeOptions}}" range-key="label" value="{{item.typeIndex}}" data-index="{{idx}}" bindchange="onDefectTypeChange">
            <view class="qi-picker {{item.typeIndex >= 0 ? '' : 'qi-picker--empty'}}">
              <text>{{item.typeIndex >= 0 ? defectTypeOptions[item.typeIndex].label : '请选择缺陷类型'}}</text>
              <text class="qi-picker-arrow">▼</text>
            </view>
          </picker>
        </view>

        <view class="qi-form-item">
          <text class="qi-label">缺陷数量</text>
          <input class="qi-input" type="number" placeholder="输入数量" value="{{item.qty}}" data-index="{{idx}}" bindinput="onDefectQtyChange" />
        </view>

        <view class="qi-form-item">
          <text class="qi-label">缺陷说明</text>
          <textarea class="qi-textarea" placeholder="描述缺陷情况" value="{{item.desc}}" data-index="{{idx}}" bindinput="onDefectDescChange" maxlength="200" />
        </view>
      </view>
    </view>

        <view class="qi-card qi-andon-card" wx:if="{{defectAuto >= 3}}">
      <view class="qi-andon-head">
        <text class="qi-andon-icon">⚠️</text>
        <text class="qi-andon-title">不良数量 ≥ 3 件，是否发起安灯？</text>
      </view>
      <view class="qi-andon-toggle" bindtap="onToggleAndon">
        <view class="qi-andon-check {{needAndon ? 'qi-andon-checked' : ''}}">
          <text wx:if="{{needAndon}}">✓</text>
        </view>
        <text>发起安灯事件</text>
      </view>

      <block wx:if="{{needAndon}}">
        <view class="qi-form-item">
          <text class="qi-label">异常描述</text>
          <textarea class="qi-textarea" placeholder="描述异常情况" value="{{andonDesc}}" bindinput="onAndonDescInput" maxlength="300" />
        </view>
        <view class="qi-form-item">
          <text class="qi-label">建议处理方式</text>
          <picker mode="selector" range="{{andonActionOptions}}" range-key="label" value="{{andonActionIndex}}" bindchange="onAndonActionChange">
            <view class="qi-picker">{{andonActionOptions[andonActionIndex].label}}  <text class="qi-picker-arrow">▼</text></view>
          </picker>
        </view>
      </block>
    </view>

        <view class="qi-card" wx:if="{{defectAuto > 0}}">
      <text class="qi-card-title">处置动作 <text class="qi-required">*</text></text>
      <view class="qi-action-row">
        <view
          class="qi-action-item {{action === item.value ? 'qi-action--active' : ''}}"
          wx:for="{{actionOptions}}" wx:key="value"
          data-value="{{item.value}}" bindtap="onActionChange"
        >{{item.label}}</view>
      </view>
    </view>

        <view class="qi-card">
      <view class="qi-form-item">
        <text class="qi-label">备注</text>
        <textarea class="qi-textarea" placeholder="备注信息（选填）" value="{{remark}}" bindinput="onRemarkInput" maxlength="300" />
        <text class="qi-char-count">{{remark.length}}/300</text>
      </view>
    </view>

        <view class="qi-submit-wrap">
      <view class="qi-submit-btn {{submitting ? 'qi-submit--loading' : ''}}" bindtap="onSubmit">
        {{submitting ? '提交中...' : '提交质检'}}
      </view>
    </view>

  </view>
</view>
