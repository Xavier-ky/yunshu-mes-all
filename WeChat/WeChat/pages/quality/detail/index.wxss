

.page-container { min-height: 100vh; background: #0A1628; }
.qd-loading, .qd-empty { display: flex; justify-content: center; padding: 200rpx; font-size: 28rpx; color: rgba(255,255,255,0.35); }
.qd-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.qd-verdict {
  display: flex; align-items: center; gap: 20rpx;
  padding: 32rpx; border-radius: 16rpx;
}
.qd-verdict--fail { background: rgba(255,71,87,0.08); border: 1rpx solid rgba(211,47,47,0.15); }
.qd-verdict--pass { background: #F5FAF8; border: 1rpx solid rgba(46,139,139,0.15); }

.qd-verdict-icon {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 800; flex-shrink: 0;
}
.qd-verdict--fail .qd-verdict-icon { background: #D32F2F; color: #fff; }
.qd-verdict--pass .qd-verdict-icon { background: #00E896; color: #fff; }

.qd-verdict-body { display: flex; flex-direction: column; }
.qd-verdict-label { font-size: 36rpx; font-weight: 800; }
.qd-verdict--fail .qd-verdict-label { color: #FF4757; }
.qd-verdict--pass .qd-verdict-label { color: #00E896; }
.qd-verdict-type { font-size: 24rpx; color: rgba(255,255,255,0.35); margin-top: 4rpx; }

.qd-card { background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); }
.qd-card-title { font-size: 28rpx; font-weight: 700; color: #E2E8F0; margin-bottom: 24rpx; display: block; }

.qd-info-grid { display: flex; flex-wrap: wrap; }
.qd-info-item { width: 50%; padding: 10rpx 0; }
.qd-info-item:nth-child(odd) { padding-right: 24rpx; }
.qd-info-item:nth-child(n+3) { border-top: 1px dashed rgba(255,255,255,0.08); }
.qd-info-l { font-size: 24rpx; color: rgba(255,255,255,0.35); display: block; margin-bottom: 4rpx; }
.qd-info-v { font-size: 26rpx; font-weight: 500; color: #E2E8F0; }

.qd-info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 12rpx 0; }
.qd-info-row + .qd-info-row { border-top: 1px dashed rgba(255,255,255,0.08); }

.qd-qty-row { display: flex; align-items: center; justify-content: space-around; margin-bottom: 20rpx; }
.qd-qty-item { text-align: center; }
.qd-qty-num { font-size: 48rpx; font-weight: 800; color: #E2E8F0; display: block; font-family: var(--font-mono); }
.qd-qty-num.qd-green { color: #00E896; }
.qd-qty-num.qd-red { color: #FF4757; }
.qd-qty-label { font-size: 22rpx; color: rgba(255,255,255,0.35); margin-top: 4rpx; display: block; }
.qd-qty-div { font-size: 36rpx; color: rgba(255,255,255,0.10); font-weight: 300; }

.qd-rate-bar { display: flex; height: 10rpx; border-radius: 5rpx; overflow: hidden; }
.qd-rate-pass { background: #00E896; }
.qd-rate-fail { background: #D32F2F; }

.qd-defect-item { padding: 24rpx 0; }
.qd-defect-item + .qd-defect-item { border-top: 1px dashed rgba(255,255,255,0.08); }

.qd-defect-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.qd-defect-tag {
  display: inline-block; padding: 8rpx 20rpx;
  background: rgba(255,71,87,0.08); color: #FF4757;
  border-radius: 8rpx; font-size: 24rpx; font-weight: 700;
  border: 1rpx solid rgba(211,47,47,0.20);
}
.qd-defect-qty { font-size: 24rpx; color: #FF4757; font-weight: 700; font-family: var(--font-mono); }

.qd-defect-desc { font-size: 26rpx; color: rgba(255,255,255,0.45); line-height: 1.6; }

.qd-images { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.qd-img {
  width: 200rpx; height: 200rpx; border-radius: 12rpx;
  border: 1rpx solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.05);
}

.qd-action {
  padding: 6rpx 20rpx; border-radius: 6rpx;
  font-size: 24rpx !important; font-weight: 700 !important;
}
.qd-action--rework { color: #FFB800; background: rgba(212,175,55,0.08); }
.qd-action--scrap { color: #FF4757; background: rgba(211,47,47,0.06); }
.qd-action--release { color: #00E896; background: rgba(46,139,139,0.06); }

.footer-placeholder { height: 48rpx; }
