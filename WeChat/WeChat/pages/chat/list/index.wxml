<page-header title="群聊" showBack="{{true}}" />

<view class="page-container">
    <view class="cl-hint-banner">
    <text class="cl-hint-icon">💡</text>
    <text class="cl-hint-text">群聊由业务事件自动创建，业务完成后自动解散</text>
  </view>

    <view class="cl-list">
    <block wx:for="{{groupList}}" wx:key="groupId">
      <view class="cl-card" data-group-id="{{item.groupId}}" bindtap="onGroupTap">
                <view class="cl-avatar">
          <view wx:if="{{item._avatar.type === 'composite'}}" class="cl-composite-avatar">
            <block wx:for="{{item._avatar.cells}}" wx:key="gradient" wx:for-item="c">
              <view class="cl-composite-cell" style="background:linear-gradient({{c.gradient}});">
                <text>{{c.initial}}</text>
              </view>
            </block>
          </view>
          <view wx:else class="cl-avatar-icon" style="background:{{item.bizType === 'ANDON' ? '#FFF5F5' : item.bizType === 'QUALITY' ? '#F5FAF8' : item.bizType === 'MATERIAL' ? '#FFFDF5' : item.bizType === 'EQUIPMENT' ? '#F5F7FA' : '#F8F9FB'}};">
            <text>{{item._avatar.emoji || '💬'}}</text>
          </view>
        </view>

                <view class="cl-body">
          <view class="cl-head">
            <text class="cl-name">{{item.name}}</text>
            <text class="cl-time">{{item.lastTimeStr}}</text>
          </view>
          <view class="cl-preview">{{item.lastMessage || '暂无消息'}}</view>
          <view class="cl-foot">
            <view class="cl-biz-row">
              <view class="cl-biz-type-tag cl-biz--{{item.bizType}}">{{item.bizType === 'ANDON' ? '安灯' : item.bizType === 'QUALITY' ? '质检' : item.bizType === 'MATERIAL' ? '退料' : item.bizType === 'EQUIPMENT' ? '维修' : '通用'}}</view>
              <text class="cl-biz-context" wx:if="{{item.bizContext && item.bizContext.title}}">{{item.bizContext.title}}</text>
              <text class="cl-biz-status" wx:if="{{item.bizContext.statusLabel}}">· {{item.bizContext.statusLabel}}</text>
            </view>
            <text class="cl-member-count">{{item.members.length}}人</text>
          </view>
        </view>
      </view>
    </block>
  </view>

    <view class="cl-empty" wx:if="{{!loading && groupList.length === 0}}">
    <text class="cl-empty-icon">💬</text>
    <text class="cl-empty-title">暂无群聊</text>
    <text class="cl-empty-desc">当发生安灯异常、质检问题、退料或维修时，系统会自动创建沟通群组</text>
  </view>
</view>
