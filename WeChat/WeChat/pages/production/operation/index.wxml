<page-header title="生产作业" showBack="{{true}}" />

<view class="page-container">

  <view class="page-content">
    <view class="card">
      <text class="section-title mb-sm">产品信息</text>
      <view class="form-group">
        <text class="form-label">产品SN</text>
        <scan-input
          placeholder="扫描产品SN码"
          value="{{productSn}}"
          bind:scan="onScanProduct"
          bind:input="onProductInput"
          bind:identify="onProductIdentify"
        />
      </view>
      <view wx:if="{{productInfo}}" class="scan-result">
        <text class="scan-result-text">已识别: {{productInfo.code}}</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title mb-sm">物料信息</text>
      <view class="form-group">
        <text class="form-label">物料批次</text>
        <scan-input
          placeholder="扫描物料批次码"
          value="{{materialBatch}}"
          bind:scan="onScanMaterial"
          bind:input="onMaterialInput"
          bind:identify="onMaterialIdentify"
        />
      </view>
      <view wx:if="{{materialInfo}}" class="scan-result">
        <text class="scan-result-text">已识别: {{materialInfo.code}}</text>
      </view>
    </view>

    <view class="card">
      <text class="section-title mb-sm">报工数量</text>
      <view class="form-group">
        <text class="form-label">良品数量</text>
        <input
          class="form-input"
          type="number"
          placeholder="请输入良品数量"
          value="{{goodQty}}"
          bindinput="onGoodQtyInput"
        />
      </view>
      <view class="form-group">
        <text class="form-label">不良数量</text>
        <input
          class="form-input"
          type="number"
          placeholder="请输入不良数量（选填）"
          value="{{defectQty}}"
          bindinput="onDefectQtyInput"
        />
      </view>
    </view>
  </view>

  <view class="footer-placeholder"></view>
</view>

<action-footer
    primaryText="提交报工"
    primaryDisabled="{{submitting}}"
    primaryLoading="{{submitting}}"
    showSecondary="{{false}}"
    bind:primary="onSubmit"
  />