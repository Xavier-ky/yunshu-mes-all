

.page-container { min-height: 100vh; background: #0A1628; }
.detail-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 32rpx; }

.dt-card {
  background: rgba(255,255,255,0.04); border-radius: 12rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.dt-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.dt-card-head-right { display: flex; align-items: center; gap: 16rpx; }
.dt-card-title { font-size: 32rpx; font-weight: 700; color: #E2E8F0; margin-bottom: 24rpx; display: block; }
.dt-card-head .dt-card-title { margin-bottom: 0; }

.dt-info-grid { display: flex; flex-wrap: wrap; }
.dt-info-item {
  width: 50%; padding: 16rpx 0;
}
.dt-info-item:nth-child(odd) { padding-right: 24rpx; }
.dt-info-item + .dt-info-item { border-top: none; }
.dt-info-item:nth-child(n+3) { border-top: 1px dashed rgba(255,255,255,0.08); }
.dt-info-full { width: 100%; }
.dt-info-label { font-size: 24rpx; font-weight: 400; color: rgba(255,255,255,0.35); display: block; margin-bottom: 4rpx; }
.dt-info-val { font-size: 28rpx; font-weight: 500; color: #E2E8F0; display: block; }

.dt-progress-stats { display: flex; justify-content: space-around; margin-bottom: 24rpx; }
.dt-stat { text-align: center; }
.dt-stat-num { font-size: 44rpx; font-weight: 700; color: #E2E8F0; display: block; }
.dt-stat-num.good { color: #00E896; }
.dt-stat-num.defect { color: #FF4757; }
.dt-stat-label { font-size: 22rpx; font-weight: 400; color: rgba(255,255,255,0.35); margin-top: 4rpx; display: block; }

.dt-progress-wrap { display: flex; align-items: center; gap: 16rpx; }
.dt-progress-bar { flex: 1; height: 10rpx; background: rgba(255,255,255,0.06); border-radius: 5rpx; overflow: hidden; }
.dt-progress-fill { height: 100%; background: #00E896; border-radius: 5rpx; transition: width 0.4s ease; }
.dt-progress-pct { font-size: 24rpx; font-weight: 700; color: #00E896; min-width: 80rpx; text-align: right; font-family: var(--font-mono); }

.dt-remain { font-size: 24rpx; color: rgba(255,255,255,0.35); margin-top: 16rpx; display: block; }
.dt-remain-num { font-weight: 700; color: #00B4E4; }

.sop-view-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(26,58,92,0.06); border: 1rpx solid rgba(26,58,92,0.12);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}
.sop-view-btn:active { background: rgba(26,58,92,0.12); }

.andon-mini {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(255,71,87,0.08); border: 1rpx solid rgba(211,47,47,0.20);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
}
.andon-mini:active { background: rgba(211,47,47,0.08); }

.sop-indicator { display: flex; flex-direction: column; }
.sop-step-item { display: flex; flex-direction: column; align-items: flex-start; position: relative; padding-left: 56rpx; padding-bottom: 32rpx; }
.sop-step-item:last-child { padding-bottom: 0; }

.sop-step-node {
  position: absolute; left: 0; top: 0;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.35);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 600;
  z-index: 1;
}
.sop-step-done .sop-step-node { background: #00E896; color: #fff; }
.sop-step-current .sop-step-node { background: #00B4E4; color: #fff; box-shadow: 0 0 0 6rpx rgba(26,58,92,0.10); }

.sop-step-connector {
  position: absolute; left: 19rpx; top: 44rpx; bottom: 0;
  width: 2rpx; background: #E8E8E8;
}
.sop-step-done .sop-step-connector { background: #00E896; }

.sop-step-text { font-size: 26rpx; font-weight: 400; color: #E2E8F0; line-height: 1.6; }
.sop-step-done .sop-step-text { color: rgba(255,255,255,0.35); }
.sop-step-current .sop-step-text { font-weight: 600; color: #00B4E4; }

.dt-form-item { margin-bottom: 32rpx; }
.dt-form-item:last-child { margin-bottom: 0; }
.dt-form-label { font-size: 26rpx; font-weight: 400; color: rgba(255,255,255,0.35); display: block; margin-bottom: 12rpx; }

.dt-scan-row { display: flex; align-items: center; gap: 16rpx; }
.dt-input {
  flex: 1; height: 80rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 0 24rpx;
  font-size: 26rpx; color: #E2E8F0;
}
.dt-scan-btn {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; flex-shrink: 0;
}
.dt-scan-btn:active { background: rgba(26,58,92,0.05); border-color: #00B4E4; }
.dt-scan-icon { width: 40rpx; height: 40rpx; }

.dt-material-preview {
  margin-top: 24rpx; padding: 24rpx;
  background: rgba(255,255,255,0.03); border-radius: 12rpx;
}
.dt-material-preview .dt-info-item { width: 50%; display: inline-block; padding: 8rpx 0; }
.dt-material-preview .dt-info-item:nth-child(n+3) { border-top: 1px dashed rgba(255,255,255,0.08); }
.dt-confirm-btn {
  margin-top: 20rpx; height: 72rpx;
  background: #00B4E4; color: #fff;
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600;
}
.dt-confirm-btn:active { opacity: 0.85; }

.dt-chip-list { margin-top: 24rpx; display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.dt-chip-label { font-size: 24rpx; color: rgba(255,255,255,0.35); }
.dt-chip {
  background: rgba(26,58,92,0.06); border: 1rpx solid rgba(26,58,92,0.12);
  border-radius: 20rpx; padding: 8rpx 20rpx;
}
.dt-chip-text { font-size: 22rpx; color: #00B4E4; font-weight: 500; }

.dt-sn-preview {
  margin-top: 24rpx; padding: 24rpx;
  background: rgba(255,255,255,0.03); border-radius: 12rpx;
  display: flex; justify-content: space-between; align-items: center;
}
.dt-sn-text { font-size: 26rpx; color: #E2E8F0; font-weight: 500; }
.dt-sn-preview .dt-confirm-btn { margin-top: 0; padding: 0 28rpx; height: 64rpx; font-size: 24rpx; }

.dt-picker {
  height: 80rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 0 24rpx;
  font-size: 26rpx; color: #E2E8F0;
  display: flex; align-items: center;
}

.dt-stepper { display: flex; align-items: center; }
.dt-stepper-btn {
  width: 88rpx; height: 88rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 600; color: #E2E8F0;
}
.dt-stepper-btn:active { background: #E8ECF0; }
.dt-stepper-input {
  width: 160rpx; height: 88rpx; margin: 0 16rpx;
  background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx; text-align: center;
  font-size: 36rpx; font-weight: 700; color: #E2E8F0;
}

.dt-textarea {
  width: 100%; height: 180rpx;
  background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 24rpx;
  font-size: 26rpx; color: #E2E8F0; line-height: 1.6;
  box-sizing: border-box;
}

.dt-submit-wrap {
  padding: 0 0 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.dt-submit-btn {
  height: 96rpx; border-radius: 24rpx;
  background: #00B4E4; color: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx;
  box-shadow: 0 8rpx 24rpx rgba(26,58,92,0.20);
}
.dt-submit-btn:active { opacity: 0.88; transform: scale(0.98); }

.dt-material-call-btn {
  margin-top: 20rpx; height: 88rpx; border-radius: 24rpx;
  background: #FFF8F0; color: #E67E22;
  border: 2rpx solid rgba(230,126,34,0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600;
}
.dt-material-call-btn:active { opacity: 0.85; }

.dt-urge-btn {
  height: 96rpx; border-radius: 24rpx;
  background: rgba(255,255,255,0.04); color: #00B4E4;
  border: 2rpx solid #1A3A5C;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700;
}
.dt-urge-btn:active { opacity: 0.8; }

.empty-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: #E2E8F0; }
