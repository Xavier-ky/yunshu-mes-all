<page-header title="生产任务" showBack="{{true}}" />

<view class="page-container">
    <view class="filter-tabs">
    <view
      class="filter-tab {{activeStatus === item.value ? 'filter-tab--active' : ''}}"
      wx:for="{{statusList}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onStatusChange"
    >{{item.label}}</view>
  </view>

    <view class="task-list">
    <block wx:for="{{taskList}}" wx:key="taskId">
      <view class="task-card" data-task-id="{{item.taskId}}" bindtap="onTaskTap">
                <view class="task-card-top">
          <text class="task-product">{{item.productName}}</text>
          <view class="task-status-tag status-{{item.status}} {{item.status === 'ABNORMAL' ? 'status-flash' : ''}}">
            {{item.statusLabel}}
          </view>
        </view>

                <view class="task-card-sub">
          <text class="task-sub-item">{{item.taskNo}}</text>
          <text class="task-sub-divider">·</text>
          <text class="task-sub-item">{{item.processName}}</text>
          <text class="task-sub-divider">·</text>
          <text class="task-sub-item">{{item.workOrderNo}}</text>
        </view>

                <view class="task-progress-row">
          <view class="task-progress-bar">
            <view class="task-progress-fill" style="width: {{item.planQty > 0 ? item.completedQty / item.planQty * 100 : 0}}%;"></view>
          </view>
          <text class="task-progress-num">{{item.completedQty}}/{{item.planQty}}</text>
        </view>
        <text class="task-remain" wx:if="{{item.planQty - item.completedQty > 0}}">剩余 {{item.planQty - item.completedQty}} 件</text>
      </view>
    </block>
  </view>

    <view class="empty-wrap" wx:if="{{!loading && taskList.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无生产任务</text>
    <text class="empty-desc">当前筛选条件下没有任务，试试切换其他状态</text>
  </view>
</view>
