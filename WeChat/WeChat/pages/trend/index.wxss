

.page-container { min-height: 100vh; background: #0A1628; }
.tr-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.tr-kpi-strip {
  display: flex; background: rgba(255,255,255,0.04); border-radius: 16rpx;
  padding: 28rpx 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.tr-kpi-item { flex: 1; text-align: center; }
.tr-kpi-val { font-size: 36rpx; font-weight: 800; color: #E2E8F0; display: block; font-family: var(--font-mono); }
.tr-kpi-lbl { font-size: 20rpx; color: rgba(255,255,255,0.35); margin-top: 4rpx; display: block; }
.tr-kpi-div { width: 2rpx; background: rgba(255,255,255,0.06); flex-shrink: 0; }
.tr-green { color: #2E8B8B !important; }
.tr-red { color: #D32F2F !important; }

.tr-dual-cards { display: flex; gap: 24rpx; }
.tr-dual-card {
  flex: 1; background: rgba(255,255,255,0.04); border-radius: 16rpx;
  padding: 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.tr-dc-label { font-size: 24rpx; color: rgba(255,255,255,0.35); display: block; }
.tr-dc-value { font-size: 52rpx; font-weight: 800; color: #E2E8F0; display: block; margin-top: 4rpx; font-family: var(--font-mono); }
.tr-dc-sub { font-size: 22rpx; color: rgba(255,255,255,0.25); }
.tr-dc-bar {
  height: 8rpx; background: rgba(255,255,255,0.06); border-radius: 4rpx;
  margin-top: 16rpx; overflow: hidden;
}
.tr-dc-fill { height: 100%; border-radius: 4rpx; transition: width 0.6s ease; }
.tr-dc-fill--blue { background: #00B4E4; }
.tr-dc-fill--green { background: #00E896; }

.tr-card {
  background: rgba(255,255,255,0.04); border-radius: 16rpx; padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.tr-card-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28rpx; }
.tr-card-title { font-size: 28rpx; font-weight: 700; color: #E2E8F0; }
.tr-card-sub { font-size: 22rpx; color: rgba(255,255,255,0.25); }

.tr-chart-wrap { display: flex; height: 380rpx; }

.tr-y-axis {
  display: flex; flex-direction: column; justify-content: space-between;
  width: 80rpx; padding-right: 12rpx; flex-shrink: 0;
}
.tr-y-label { font-size: 20rpx; color: rgba(255,255,255,0.25); text-align: right; font-family: var(--font-mono); }

.tr-chart-main { flex: 1; position: relative; }

.tr-grid-lines {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; justify-content: space-between;
  pointer-events: none;
}
.tr-grid-line { height: 1rpx; background: rgba(255,255,255,0.06); }

.tr-bars-row {
  display: flex; align-items: flex-end; justify-content: space-around;
  height: 100%; position: relative; z-index: 1; padding: 0 8rpx;
}
.tr-bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
.tr-bar-val {
  font-size: 20rpx; color: #00B4E4; font-weight: 600;
  font-family: var(--font-mono); margin-bottom: 4rpx;
}
.tr-bar-pillar {
  width: 44rpx; flex: 1; border-radius: 8rpx 8rpx 0 0;
  position: relative; min-height: 4rpx; background: transparent;
}
.tr-bar-fill {
  position: absolute; bottom: 0; width: 100%;
  background: linear-gradient(180deg, #3A6A9C 0%, #1A3A5C 100%);
  border-radius: 8rpx 8rpx 0 0; transition: height 0.5s ease;
}
.tr-bar-date { font-size: 20rpx; color: rgba(255,255,255,0.35); margin-top: 10rpx; font-family: var(--font-mono); }

.tr-rate-list { display: flex; flex-direction: column; gap: 20rpx; }
.tr-rate-row { display: flex; align-items: center; gap: 16rpx; }
.tr-rate-date { font-size: 24rpx; color: rgba(255,255,255,0.35); width: 90rpx; flex-shrink: 0; font-family: var(--font-mono); }
.tr-rate-track {
  flex: 1; height: 20rpx; background: rgba(255,255,255,0.06);
  border-radius: 10rpx; overflow: hidden;
}
.tr-rate-fill { height: 100%; border-radius: 10rpx; transition: width 0.5s ease; }
.tr-rate-pct { font-size: 24rpx; font-weight: 700; width: 72rpx; text-align: right; font-family: var(--font-mono); }

.tr-table { width: 100%; }
.tr-table-head {
  display: flex; padding: 16rpx 0; border-bottom: 2rpx solid #1A3A5C;
  margin-bottom: 8rpx;
}
.tr-th { flex: 1; text-align: center; font-size: 22rpx; font-weight: 700; color: #00B4E4; }
.tr-th-date { flex: 1.3; }

.tr-table-row { display: flex; padding: 20rpx 0; align-items: center; }
.tr-table-row + .tr-table-row { border-top: 1px dashed rgba(255,255,255,0.08); }
.tr-td { flex: 1; text-align: center; font-size: 24rpx; color: rgba(255,255,255,0.45); font-family: var(--font-mono); }
.tr-td-date { flex: 1.3; color: rgba(255,255,255,0.35); }

.tr-status {
  display: inline-block; padding: 4rpx 16rpx; border-radius: 6rpx;
  font-size: 20rpx; font-weight: 600;
}
.tr-status--good { color: #00E896; background: rgba(46,139,139,0.08); }
.tr-status--warn { color: #FFB800; background: rgba(212,175,55,0.08); }
.tr-status--bad { color: #FF4757; background: rgba(211,47,47,0.06); }

.footer-placeholder { height: 48rpx; }
