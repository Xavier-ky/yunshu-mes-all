

.page-scroll { height: 100vh; }

.andon-type-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.andon-type-card {
  padding: 28rpx 16rpx; border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border); background: var(--color-card);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s;
}
.andon-type-name { font-size: 28rpx; font-weight: 600; color: var(--color-text); }

.type-material  { border-color: #D4AF37; background: rgba(212,175,55,0.06); }
.type-equipment { border-color: #FF4757; background: rgba(255,71,87,0.06); }
.type-process   { border-color: #00B4E4; background: rgba(0,180,240,0.06); }
.type-quality   { border-color: #00E896; background: rgba(0,232,150,0.06); }

.andon-target-bar {
  margin-top: 20rpx; padding: 16rpx 20rpx;
  background: rgba(0,180,240,0.06); border: 1rpx solid rgba(0,180,240,0.12);
  border-radius: var(--radius-sm); display: flex; align-items: flex-start; gap: 10rpx;
}
.andon-target-icon { font-size: 28rpx; flex-shrink: 0; }
.andon-target-text { font-size: 24rpx; color: var(--color-text-secondary); line-height: 1.5; }
.andon-target-name { color: var(--color-primary); font-weight: 600; }
.andon-content { padding: 24rpx 28rpx; display: flex; flex-direction: column; gap: 20rpx; }

.ac-card {
  background: var(--color-card); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg); padding: 28rpx;
}
.ac-related {
  background: rgba(0,180,240,0.04); border-color: rgba(0,180,240,0.10);
}

.ac-section-title {
  font-size: 26rpx; font-weight: 700; color: var(--color-primary);
  margin-bottom: 20rpx; display: block;
}
.ac-info-tag {
  display: flex; align-items: center; gap: 16rpx;
  padding: 14rpx 18rpx; margin-bottom: 20rpx;
  background: rgba(255,255,255,0.03); border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
}
.ac-info-tag-label { font-size: 22rpx; color: var(--color-text-placeholder); }
.ac-info-tag-val   { font-size: 24rpx; font-weight: 600; color: var(--color-text); }

.ac-form-item { margin-bottom: 24rpx; }
.ac-form-item:last-child { margin-bottom: 0; }
.ac-label {
  font-size: 26rpx; font-weight: 500; color: var(--color-text-secondary);
  display: block; margin-bottom: 10rpx;
}
.ac-label-hint { font-weight: 400; color: var(--color-text-placeholder); font-size: 24rpx; }
.ac-required { color: #FF4757; margin-left: 4rpx; }

.ac-form-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.ac-form-half { flex: 1; min-width: 0; }

.ac-picker {
  display: flex; align-items: center; justify-content: space-between;
  height: 80rpx; background: rgba(255,255,255,0.03);
  border: 1rpx solid var(--color-border); border-radius: var(--radius-md);
  padding: 0 22rpx; font-size: 26rpx; color: var(--color-text);
}
.ac-picker--empty { color: var(--color-text-placeholder); }
.ac-picker-arrow { font-size: 22rpx; color: var(--color-text-placeholder); }

.ac-input {
  flex: 1; height: 80rpx;
  background: rgba(255,255,255,0.03); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md); padding: 0 22rpx;
  font-size: 26rpx; color: var(--color-text);
}
.ac-input:focus { border-color: var(--color-primary); }

.ac-scan-row { display: flex; align-items: center; gap: 12rpx; }
.ac-scan-btn {
  width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.03); border: 1rpx solid var(--color-border);
  display: flex; align-items: center; justify-content: center;
}
.ac-scan-btn:active { background: var(--color-primary-light); border-color: var(--color-primary); }
.ac-scan-icon { width: 36rpx; height: 36rpx; }

.ac-textarea {
  width: 100%; height: 200rpx;
  background: rgba(255,255,255,0.03); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md); padding: 20rpx 22rpx;
  font-size: 26rpx; color: var(--color-text); line-height: 1.6;
  box-sizing: border-box;
}
.ac-char-count {
  text-align: right; display: block;
  font-size: 22rpx; color: var(--color-text-placeholder);
  margin-top: 6rpx;
}

.ac-image-grid {
  display: flex; flex-wrap: wrap;
  gap: 16rpx;
}
.ac-image-item {
  position: relative;
  width: 200rpx; height: 200rpx;
  border-radius: var(--radius-md); overflow: hidden;
  border: 1rpx solid var(--color-border);
}
.ac-image-thumb { width: 100%; height: 100%; }
.ac-image-del {
  position: absolute; top: 0; right: 0;
  width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
  border-radius: 0 var(--radius-md) 0 var(--radius-md);
  font-size: 22rpx; color: #fff;
}
.ac-upload-btn {
  width: 200rpx; height: 200rpx;
  background: rgba(255,255,255,0.02); border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8rpx;
}
.ac-upload-btn:active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}
.ac-upload-icon { width: 48rpx; height: 48rpx; }
.ac-upload-text { font-size: 22rpx; color: var(--color-text-placeholder); }
.ac-image-hint {
  font-size: 22rpx; color: var(--color-text-placeholder);
  display: block; margin-top: 14rpx;
}

.ac-bottom { height: 120rpx; }
