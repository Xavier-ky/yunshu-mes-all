<page-header title="安灯详情" showBack="{{true}}" />

<view class="page-container">
  <empty-state wx:if="{{!loading && !event}}" text="未找到安灯事件" />

  <block wx:if="{{event}}">
    <view class="page-content">
            <view class="card">
        <view class="flex-between mb-sm">
          <text class="event-no">{{event.eventNo}}</text>
          <status-tag status="{{event.status}}">{{event.statusLabel}}</status-tag>
        </view>
        <view class="flex-between">
          <view class="flex-row">
            <text class="info-label-sm">事件类型：</text>
            <text class="info-value">{{event.eventTypeName}}</text>
          </view>
          <view class="flex-row">
            <text class="info-label-sm">优先级：</text>
            <text class="priority-text priority-{{event.priority === 'HIGH' ? 'high' : (event.priority === 'MEDIUM' ? 'medium' : 'low')}}">{{event.priority === 'HIGH' ? '高' : (event.priority === 'MEDIUM' ? '中' : '低')}}</text>
          </view>
        </view>
      </view>

            <view class="card">
        <view class="section-title">关联信息</view>
        <view class="info-row">
          <text class="info-label">工单号</text>
          <text class="info-value">{{event.workOrderNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">产线</text>
          <text class="info-value">{{event.lineName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">工位</text>
          <text class="info-value">{{event.workstationName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">设备编码</text>
          <text class="info-value">{{event.deviceCode || '--'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">设备名称</text>
          <text class="info-value">{{event.deviceName || '--'}}</text>
        </view>
      </view>

            <view class="card">
        <view class="section-title">问题描述</view>
        <view class="description-text">{{event.description || '无'}}</view>
        <view class="images-row" wx:if="{{event.images && event.images.length > 0}}">
          <image
            wx:for="{{event.images}}"
            wx:key="index"
            class="desc-image"
            src="{{item}}"
            mode="aspectFill"
            bindtap="onPreviewDescImage"
            data-index="{{index}}"
          />
        </view>
      </view>

            <view class="card" wx:if="{{event.targetPerson}}">
        <view class="section-title">通知信息</view>
        <view class="info-row">
          <text class="info-label">通知对象</text>
          <text class="info-value">{{event.targetPerson}}（{{event.targetRoleName}}）</text>
        </view>
        <view class="info-row" wx:if="{{event.groupId}}">
          <text class="info-label">沟通群聊</text>
          <text class="info-value link-text" bindtap="onGoChat">查看群聊 ›</text>
        </view>
      </view>

            <view class="card">
        <view class="section-title">状态时间线</view>
        <view class="timeline">
          <view class="timeline-item">
            <view class="timeline-dot timeline-dot-active"></view>
            <view class="timeline-content">
              <text class="timeline-label">发起时间</text>
              <text class="timeline-time">{{event.createTime}}</text>
            </view>
          </view>
          <view class="timeline-item">
            <view class="timeline-dot {{event.responseTime ? 'timeline-dot-active' : 'timeline-dot-inactive'}}"></view>
            <view class="timeline-content">
              <text class="timeline-label">响应时间</text>
              <text class="timeline-time">{{event.responseTime || '待响应'}}</text>
            </view>
          </view>
          <view class="timeline-item">
            <view class="timeline-dot {{event.resolveTime ? 'timeline-dot-active' : 'timeline-dot-inactive'}}"></view>
            <view class="timeline-content">
              <text class="timeline-label">解决时间</text>
              <text class="timeline-time">{{event.resolveTime || '待解决'}}</text>
            </view>
          </view>
        </view>
      </view>

            <view class="card">
        <view class="section-title">处理记录</view>
        <view wx:if="{{event.handleRecords && event.handleRecords.length > 0}}">
          <view class="handle-record" wx:for="{{event.handleRecords}}" wx:key="index">
            <view class="record-header">
              <text class="record-handler">{{item.handlerName || item.handler}}</text>
              <text class="record-time">{{item.time}}</text>
            </view>
            <text class="record-action">{{item.action}}</text>
          </view>
        </view>
        <view wx:else class="no-records">暂无处理记录</view>
      </view>
    </view>

        <view class="handle-btn-area" wx:if="{{showHandleBtn}}">
      <button class="btn btn-primary btn-block" bindtap="goToHandle">处理</button>
    </view>

        <view class="bottom-placeholder"></view>
  </block>
</view>