

.link-text { color: var(--color-primary); font-weight: 500; }

.page-container { min-height: 100vh; background: #0A1628; }
.page-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.card { background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-row { display: flex; align-items: center; }
.mb-sm { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #E2E8F0; margin-bottom: 24rpx; display: block; }

.event-no { font-size: 30rpx; font-weight: 700; color: #E2E8F0; }

.info-label-sm { font-size: 24rpx; color: rgba(255,255,255,0.35); }
.info-value { font-size: 26rpx; font-weight: 500; color: #E2E8F0; }

.priority-text { font-size: 24rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 6rpx; }
.priority-high { color: #FF4757; background: rgba(211,47,47,0.06); }
.priority-medium { color: #FFB800; background: rgba(212,175,55,0.08); }
.priority-low { color: rgba(255,255,255,0.35); background: rgba(0,0,0,0.04); }

.info-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 12rpx 0; }
.info-row + .info-row { border-top: 1px dashed rgba(255,255,255,0.08); }
.info-label { font-size: 24rpx; color: rgba(255,255,255,0.35); flex-shrink: 0; }
.info-value { font-size: 26rpx; font-weight: 500; color: #E2E8F0; text-align: right; flex: 1; margin-left: 24rpx; }

.description-text {
  font-size: 26rpx; color: rgba(255,255,255,0.45); line-height: 1.7;
  white-space: pre-wrap; word-break: break-all;
}

.images-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.desc-image { width: 160rpx; height: 160rpx; border-radius: 12rpx; border: 1rpx solid rgba(255,255,255,0.08); }

.timeline { padding-left: 8rpx; }
.timeline-item {
  display: flex; align-items: flex-start; padding-bottom: 28rpx; position: relative;
}
.timeline-item:last-child { padding-bottom: 0; }

.timeline-item::before {
  content: ''; position: absolute; left: 7rpx; top: 20rpx; bottom: 0;
  width: 2rpx; background: rgba(255,255,255,0.06);
}
.timeline-item:last-child::before { display: none; }

.timeline-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  flex-shrink: 0; margin-right: 16rpx; margin-top: 6rpx;
  position: relative; z-index: 1;
}
.timeline-dot-active { background: #00B4E4; box-shadow: 0 0 0 4rpx rgba(26,58,92,0.10); }
.timeline-dot-inactive { background: rgba(255,255,255,0.08); }

.timeline-content { flex: 1; display: flex; flex-direction: column; }
.timeline-label { font-size: 24rpx; color: rgba(255,255,255,0.35); margin-bottom: 2rpx; }
.timeline-time { font-size: 24rpx; color: #E2E8F0; font-family: var(--font-mono); }

.handle-record { padding: 20rpx 0; }
.handle-record + .handle-record { border-top: 1px dashed rgba(255,255,255,0.08); }
.record-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.record-handler { font-size: 26rpx; font-weight: 600; color: #E2E8F0; }
.record-time { font-size: 22rpx; color: rgba(255,255,255,0.25); }
.record-action { font-size: 24rpx; color: rgba(255,255,255,0.40); line-height: 1.5; }
.no-records { text-align: center; font-size: 24rpx; color: rgba(255,255,255,0.25); padding: 32rpx 0; }

.handle-btn-area {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 16rpx 32rpx; background: rgba(255,255,255,0.04);
  border-top: 1rpx solid #E8E8E8;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 10;
}
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 16rpx; font-size: 30rpx; font-weight: 700;
}
.btn-primary { background: #00B4E4; color: #fff; box-shadow: 0 4rpx 16rpx rgba(26,58,92,0.18); }
.btn-primary:active { opacity: 0.9; transform: scale(0.98); }
.btn-block { width: 100%; }

.bottom-placeholder { height: 140rpx; }
