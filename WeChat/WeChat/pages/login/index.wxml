<view class="page-container flex-center">
  <view class="login-card">
        <view class="login-logo-wrap">
      <view class="login-logo-ring"></view>
      <view class="login-logo-ring2"></view>
      <view class="login-logo-glow"></view>
      <image
        class="login-logo"
        src="data:image/svg+xml;base64,"
        mode="aspectFit"
      />
    </view>

        <view class="login-header">
      <text class="login-title">云 枢 智 造</text>
      <text class="login-subtitle">MES · 现场作业平台</text>
    </view>

        <view class="login-form">
      <view class="form-group">
        <view class="form-label">账号</view>
        <input
          class="form-input"
          placeholder="请输入账号"
          value="{{username}}"
          bindinput="onUsernameInput"
        />
      </view>
      <view class="form-group">
        <view class="form-label">密码</view>
        <input
          class="form-input"
          placeholder="请输入密码"
          password
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>
      <button class="btn btn-primary btn-block mt-lg" bindtap="onLogin" loading="{{loading}}">登 录</button>
    </view>

  </view>
</view>
