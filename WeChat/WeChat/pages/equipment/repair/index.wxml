<page-header title="{{pageMode === 'process' ? '维修处理' : (form.maintenanceType === 'maintenance' ? '设备保养' : '设备报修')}}" showBack="{{true}}" />

<view class="page-container">
  <view class="page-content">
        <block wx:if="{{deviceInfo}}">
      <view class="card card-highlight">
        <view class="flex-between mb-sm">
          <text class="section-title" style="margin-bottom:0">设备信息</text>
          <status-tag wx:if="{{deviceInfo.status}}" status="{{deviceInfo.status}}">{{deviceInfo.statusLabel}}</status-tag>
        </view>
        <view class="info-row">
          <text class="info-label">设备编号</text>
          <text class="info-value">{{deviceInfo.deviceCode}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">设备名称</text>
          <text class="info-value">{{deviceInfo.deviceName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">所属产线</text>
          <text class="info-value">{{deviceInfo.lineName || '--'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">所属工位</text>
          <text class="info-value">{{deviceInfo.workstationName || '--'}}</text>
        </view>
        <view class="info-row" wx:if="{{deviceInfo.faultDescription}}">
          <text class="info-label">故障描述</text>
          <text class="info-value text-danger">{{deviceInfo.faultDescription}}</text>
        </view>
      </view>
    </block>

        <block wx:if="{{pageMode === 'create'}}">
            <view class="card" wx:if="{{!deviceInfo}}">
        <text class="section-title">扫描设备</text>
        <scan-input
          placeholder="扫描或输入设备编号"
          value="{{form.deviceCode}}"
          bind:scan="onDeviceCodeScan"
          bind:input="onDeviceCodeInput"
        />
      </view>

            <view class="card">
                <view class="type-toggle mb-sm">
          <view class="type-toggle-item {{form.maintenanceType === 'repair' ? 'active' : ''}}" bindtap="onTypeToggle" data-type="repair">报修</view>
          <view class="type-toggle-item {{form.maintenanceType === 'maintenance' ? 'active' : ''}}" bindtap="onTypeToggle" data-type="maintenance">保养</view>
        </view>

                <view class="form-group">
          <text class="form-label">设备名称 <text style="color:#FF6B6B">*</text></text>
          <input class="form-input" placeholder="请输入设备名称" value="{{form.deviceName}}" bindinput="onFieldInput" data-field="deviceName" />
        </view>

        <view class="form-group">
          <text class="form-label">{{form.maintenanceType === 'maintenance' ? '保养类型' : '故障类型'}} <text style="color:#FF6B6B">*</text></text>
          <picker
            mode="selector"
            range="{{form.maintenanceType === 'maintenance' ? maintenanceTypeList : faultTypeList}}"
            range-key="label"
            value="{{form.maintenanceType === 'maintenance' ? form.maintenanceTypeIndex : form.faultTypeIndex}}"
            bindchange="onFaultTypeChange"
          >
            <view class="form-input picker-input flex-row flex-between">
              <text class="{{(form.maintenanceType === 'maintenance' ? form.maintenanceTypeIndex : form.faultTypeIndex) === -1 ? 'placeholder-text' : ''}}">
                {{(form.maintenanceType === 'maintenance' ? form.maintenanceTypeIndex : form.faultTypeIndex) === -1 ? (form.maintenanceType === 'maintenance' ? '请选择保养类型' : '请选择故障类型') : (form.maintenanceType === 'maintenance' ? maintenanceTypeList[form.maintenanceTypeIndex].label : faultTypeList[form.faultTypeIndex].label)}}
              </text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <view class="form-group">
          <text class="form-label">紧急程度</text>
          <view class="urgency-options">
            <view
              class="urgency-option {{form.urgencyIndex === index ? 'active' : ''}}"
              wx:for="{{urgencyOptions}}"
              wx:key="value"
              data-index="{{index}}"
              bindtap="onUrgencyChange"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">{{form.maintenanceType === 'maintenance' ? '保养说明' : '故障描述'}} <text style="color:#FF6B6B">*</text></text>
          <textarea
            class="form-textarea"
            placeholder="{{form.maintenanceType === 'maintenance' ? '请描述保养内容和要求...' : '请详细描述设备故障现象...'}}"
            value="{{form.faultDescription}}"
            bindinput="onFieldInput"
            data-field="faultDescription"
            maxlength="500"
          />
          <text class="textarea-count">{{form.faultDescription.length}}/500</text>
        </view>

        <view class="form-group">
          <text class="form-label">现场图片</text>
          <view class="image-upload-wrap">
            <view wx:for="{{form.images}}" wx:key="index" class="image-item" data-index="{{index}}" bindtap="onPreviewImage">
              <image src="{{item}}" mode="aspectFill" class="image-thumb" />
              <view class="image-remove" data-index="{{index}}" catchtap="onRemoveImage">&times;</view>
            </view>
            <view wx:if="{{form.images.length < 9}}" class="image-add" bindtap="onAddImage">
              <image class="add-icon" src="/images/相机_camera.svg" mode="aspectFit" />
              <text class="add-text">添加图片</text>
            </view>
          </view>
        </view>
      </view>
    </block>

        <block wx:if="{{pageMode === 'process'}}">
      <view class="card accept-card" wx:if="{{!processForm.accepted}}">
        <view class="accept-tip">
          <text class="accept-tip-icon">🔧</text>
          <text class="accept-tip-text">请先接收维修任务，再进行处理</text>
        </view>
        <button class="btn btn-accept" bindtap="onAcceptTask" loading="{{accepting}}">接收任务</button>
      </view>

      <view class="card" wx:if="{{processForm.accepted}}">
        <text class="section-title mb-sm">维修处理</text>
        <view class="form-group">
          <text class="form-label">维修说明 <text style="color:#FF6B6B">*</text></text>
          <textarea class="form-textarea" placeholder="请描述维修过程和措施" value="{{processForm.repairMethod}}" bindinput="onProcessFieldInput" data-field="repairMethod" maxlength="500" />
        </view>
        <view class="form-group">
          <text class="form-label">更换部件</text>
          <input class="form-input" placeholder="更换的零部件（选填）" value="{{processForm.replacedParts}}" bindinput="onProcessFieldInput" data-field="replacedParts" />
        </view>
        <view class="form-group">
          <text class="form-label">维修时长（分钟）<text style="color:#FF6B6B">*</text></text>
          <input class="form-input" type="number" placeholder="请输入维修花费分钟数" value="{{processForm.repairDuration}}" bindinput="onDurationInput" />
        </view>
        <view class="form-group">
          <text class="form-label">维修结果 <text style="color:#FF6B6B">*</text></text>
          <view class="result-options">
            <view class="result-option {{processForm.resultIndex === index ? 'active' : ''}}" wx:for="{{resultOptions}}" wx:key="value" data-index="{{index}}" bindtap="onResultChange">
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
        <view class="form-group">
          <text class="form-label">备注</text>
          <textarea class="form-textarea" placeholder="备注（选填）" value="{{processForm.remark}}" bindinput="onProcessFieldInput" data-field="remark" maxlength="300" />
        </view>
      </view>
    </block>
  </view>

  <view class="footer-placeholder"></view>
</view>

<action-footer
  wx:if="{{pageMode !== 'process' || processForm.accepted}}"
  primaryText="{{pageMode === 'process' ? '提交维修结果' : (form.maintenanceType === 'maintenance' ? '提交保养' : '提交报修')}}"
  primaryDisabled="{{submitting}}"
  primaryLoading="{{submitting}}"
  bind:primary="onSubmit"
/>
