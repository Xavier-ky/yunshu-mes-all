

.page-container { min-height: 100vh; background: #0A1628; }
.page-content { padding: 24rpx 32rpx; display: flex; flex-direction: column; gap: 24rpx; }

.card { background: rgba(255,255,255,0.04); border-radius: 12rpx; padding: 32rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03); }
.card-highlight { border: 1rpx solid rgba(0,180,240,0.15); background: rgba(0,180,240,0.04); }
.mb-sm { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #E2E8F0; display: block; margin-bottom: 24rpx; }

.info-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.info-row + .info-row { border-top: 1px dashed rgba(255,255,255,0.08); }
.info-label { font-size: 24rpx; color: rgba(255,255,255,0.35); flex-shrink: 0; }
.info-value { font-size: 26rpx; font-weight: 500; color: #E2E8F0; text-align: right; flex: 1; margin-left: 24rpx; }

.text-danger { color: #FF6B6B !important; }
.text-warn { color: #FFB800; }

.form-group { margin-bottom: 28rpx; }
.form-group:last-child { margin-bottom: 0; }
.form-label { font-size: 26rpx; color: #E2E8F0; font-weight: 500; margin-bottom: 12rpx; display: block; }

.form-input {
  width: 100%; height: 88rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; color: #E2E8F0;
  box-sizing: border-box;
}
.form-input:focus { border-color: rgba(0,180,240,0.35); }
.form-input[disabled] { opacity: 0.4; }

.form-textarea {
  width: 100%; height: 180rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 24rpx; font-size: 26rpx; color: #E2E8F0; box-sizing: border-box;
}
.form-textarea:focus { border-color: rgba(0,180,240,0.35); }
.form-textarea[disabled] { opacity: 0.4; }
.textarea-count { text-align: right; font-size: 22rpx; color: rgba(255,255,255,0.25); margin-top: 8rpx; }

.picker-input {
  display: flex; align-items: center; justify-content: space-between;
  height: 88rpx; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx; padding: 0 24rpx; font-size: 26rpx; color: #E2E8F0;
}
.placeholder-text { color: rgba(255,255,255,0.25); }
.picker-arrow { font-size: 32rpx; color: rgba(255,255,255,0.25); }

.type-toggle { display: flex; background: rgba(255,255,255,0.05); border-radius: 12rpx; padding: 4rpx; }
.type-toggle-item {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 10rpx;
  font-size: 28rpx; font-weight: 500; color: rgba(255,255,255,0.35);
  transition: all 0.2s ease;
}
.type-toggle-item.active {
  background: rgba(0,180,240,0.15); color: #00B4E4; font-weight: 700;
}

.urgency-options { display: flex; gap: 16rpx; }
.urgency-option {
  flex: 1; text-align: center; padding: 20rpx 8rpx; border-radius: 12rpx;
  background: rgba(255,255,255,0.05); font-size: 26rpx; color: rgba(255,255,255,0.35);
  border: 2rpx solid transparent; transition: all 0.15s;
}
.urgency-option.active { border-color: #FFB800; color: #FFB800; font-weight: 600; background: rgba(255,184,0,0.06); }

.image-upload-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item {
  position: relative; width: 160rpx; height: 160rpx;
  border-radius: 12rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,0.08);
}
.image-thumb { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 0; right: 0;
  width: 40rpx; height: 40rpx; background: rgba(0,0,0,0.5);
  color: #fff; font-size: 28rpx; display: flex;
  align-items: center; justify-content: center;
  border-radius: 0 0 0 12rpx;
}
.image-add {
  width: 160rpx; height: 160rpx; border: 2rpx dashed rgba(255,255,255,0.12);
  border-radius: 12rpx; background: rgba(255,255,255,0.03);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  transition: all 0.15s;
}
.image-add:active { border-color: rgba(0,180,240,0.3); background: rgba(0,180,240,0.05); }
.add-icon { width: 48rpx; height: 48rpx; }
.add-text { font-size: 22rpx; color: rgba(255,255,255,0.25); margin-top: 4rpx; }

.result-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.result-option {
  flex: 1; min-width: 120rpx; text-align: center;
  padding: 20rpx 8rpx; border-radius: 12rpx;
  background: rgba(255,255,255,0.05); font-size: 26rpx; color: rgba(255,255,255,0.35);
  border: 2rpx solid transparent; transition: all 0.15s;
}
.result-option.active {
  background: rgba(0,180,240,0.08); color: #00B4E4;
  border-color: #00B4E4; font-weight: 600;
}

.accept-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 32rpx; }
.accept-tip { display: flex; flex-direction: column; align-items: center; margin-bottom: 32rpx; }
.accept-tip-icon { font-size: 56rpx; margin-bottom: 16rpx; }
.accept-tip-text { font-size: 26rpx; color: rgba(255,255,255,0.40); text-align: center; }
.btn-accept {
  width: 100%; height: 88rpx; background: linear-gradient(135deg, #00B4E4 0%, #0099CC 100%);
  color: #fff; font-size: 30rpx; font-weight: 600; border-radius: 44rpx;
  border: none; display: flex; align-items: center; justify-content: center;
}
.btn-accept:active { opacity: 0.85; }

.flex-row { display: flex; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.footer-placeholder { height: 140rpx; }
