<page-header title="设备详情" showBack="{{true}}" />

<view class="page-container">
  <view class="page-content" wx:if="{{device}}">
        <view class="card">
      <view class="flex-between mb-sm">
        <text class="section-title">{{device.deviceName}}</text>
        <status-tag status="{{device.status}}">{{device.statusLabel}}</status-tag>
      </view>
      <view class="info-row">
        <text class="info-label">设备编号</text>
        <text class="info-value">{{device.deviceCode}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">设备型号</text>
        <text class="info-value">{{device.deviceModel}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">所属产线</text>
        <text class="info-value">{{device.lineName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">所属工位</text>
        <text class="info-value">{{device.workstationName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">投入使用</text>
        <text class="info-value">{{device.installDate || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">最后保养</text>
        <text class="info-value">{{device.lastMaintainTime || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">状态更新时间</text>
        <text class="info-value">{{device.statusUpdateTime || '--'}}</text>
      </view>
    </view>

        <view wx:if="{{device.status === 'FAULT' || device.status === 'REPAIRING'}}" class="card">
      <text class="section-title mb-sm">当前故障</text>
      <view class="info-row">
        <text class="info-label">故障编号</text>
        <text class="info-value">{{device.faultCode || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">故障名称</text>
        <text class="info-value">{{device.faultName || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">故障描述</text>
        <text class="info-value">{{device.faultDescription || '--'}}</text>
      </view>
    </view>

        <view wx:if="{{device.faultRecords && device.faultRecords.length > 0}}" class="card">
      <text class="section-title mb-sm">故障记录</text>
      <view wx:for="{{device.faultRecords}}" wx:key="faultId" class="record-item">
        <view class="info-row">
          <text class="info-label">故障编号</text>
          <text class="info-value">{{item.faultCode}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">故障描述</text>
          <text class="info-value">{{item.faultDescription}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">上报人</text>
          <text class="info-value">{{item.reportedBy}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">故障时间</text>
          <text class="info-value">{{item.faultTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">状态</text>
          <text class="info-value">{{item.statusLabel}}</text>
        </view>
        <view wx:if="{{index < device.faultRecords.length - 1}}" class="divider"></view>
      </view>
    </view>

        <view wx:if="{{device.repairRecords && device.repairRecords.length > 0}}" class="card">
      <text class="section-title mb-sm">维修记录</text>
      <view wx:for="{{device.repairRecords}}" wx:key="repairId" class="record-item">
        <view class="info-row">
          <text class="info-label">维修编号</text>
          <text class="info-value">{{item.repairId}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">故障描述</text>
          <text class="info-value">{{item.faultDescription}}</text>
        </view>
        <view wx:if="{{item.repairResult}}" class="info-row">
          <text class="info-label">维修结果</text>
          <text class="info-value">{{item.repairResult}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">维修时间</text>
          <text class="info-value">{{item.repairTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">维修人员</text>
          <text class="info-value">{{item.repairBy}}</text>
        </view>
        <view wx:if="{{index < device.repairRecords.length - 1}}" class="divider"></view>
      </view>
    </view>

        <view wx:if="{{device.inspectRecords && device.inspectRecords.length > 0}}" class="card">
      <text class="section-title mb-sm">点检记录</text>
      <view wx:for="{{device.inspectRecords}}" wx:key="inspectId" class="record-item">
        <view class="info-row">
          <text class="info-label">点检时间</text>
          <text class="info-value">{{item.inspectTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">点检人</text>
          <text class="info-value">{{item.inspectBy}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">结果</text>
          <text class="info-value {{item.result === 'ABNORMAL' ? 'text-danger' : item.result === 'NORMAL' ? 'text-success' : ''}}">{{item.resultLabel}}</text>
        </view>
        <view wx:if="{{index < device.inspectRecords.length - 1}}" class="divider"></view>
      </view>
    </view>
  </view>

  <empty-state wx:elif="{{!loading && !device}}" text="设备不存在" />

  <view class="footer-placeholder"></view>
</view>

<action-footer
  wx:if="{{device}}"
  primaryText="设备报修"
  secondaryText="扫码追溯"
  bind:primary="onRepair"
  bind:secondary="onTrace"
/>
