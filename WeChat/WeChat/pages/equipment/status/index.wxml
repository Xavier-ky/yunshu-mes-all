<page-header title="设备状态" showBack="{{true}}" />

<view class="page-container">

  <scroll-view scroll-x class="filter-bar">
    <view
      class="filter-item {{activeStatus === item.value ? 'active' : ''}}"
      wx:for="{{statusList}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onStatusChange"
    >{{item.label}}</view>
  </scroll-view>

  <view class="page-content">
    <block wx:for="{{deviceList}}" wx:key="deviceId">
      <view class="card device-card" data-device-code="{{item.deviceCode}}" bindtap="onDeviceTap">
        <view class="flex-between">
          <view class="device-info">
            <text class="device-code">{{item.deviceCode}}</text>
            <text class="device-name">{{item.deviceName}}</text>
          </view>
          <status-tag status="{{item.status}}">{{item.statusLabel}}</status-tag>
        </view>
        <view class="flex-row mt-sm">
          <text class="device-model">{{item.deviceModel}}</text>
          <text class="device-line ml-sm">{{item.lineName}}</text>
        </view>
        <view wx:if="{{item.status === 'FAULT' || item.status === 'REPAIRING'}}" class="fault-info mt-sm">
          <text class="fault-label">故障：</text>
          <text class="fault-text">{{item.faultName || item.faultDescription}}</text>
        </view>
      </view>
    </block>

    <empty-state wx:if="{{!loading && deviceList.length === 0}}" text="暂无设备" />
  </view>
</view>