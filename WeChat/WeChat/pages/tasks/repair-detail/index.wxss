

.page-container { height: 100vh; display: flex; flex-direction: column; background: #0A1628; }
.rd-scroll { flex: 1; overflow-y: auto; }

.rd-banner {
  display: flex; align-items: center; gap: 20rpx;
  margin: 24rpx; padding: 28rpx;
  border-radius: 16rpx;
}
.rd-banner--PENDING    { background: linear-gradient(135deg, rgba(255,184,0,0.12), rgba(255,184,0,0.04)); border: 1rpx solid rgba(255,184,0,0.15); }
.rd-banner--PROCESSING { background: linear-gradient(135deg, rgba(0,180,228,0.12), rgba(0,180,228,0.04)); border: 1rpx solid rgba(0,180,228,0.15); }
.rd-banner--COMPLETED  { background: linear-gradient(135deg, rgba(0,232,150,0.10), rgba(0,232,150,0.03)); border: 1rpx solid rgba(0,232,150,0.12); }
.rd-banner-icon { font-size: 52rpx; flex-shrink: 0; }
.rd-banner-body { flex: 1; }
.rd-banner-title { font-size: 30rpx; font-weight: 700; color: #E2E8F0; display: block; }
.rd-banner-sub { font-size: 24rpx; color: rgba(255,255,255,0.40); margin-top: 4rpx; display: block; }

.rd-card {
  background: rgba(255,255,255,0.04);
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
}
.rd-section-title {
  font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,0.30);
  margin-bottom: 20rpx; display: block;
  text-transform: uppercase; letter-spacing: 2rpx;
}

.rd-info-grid { display: flex; flex-direction: column; gap: 18rpx; }
.rd-info-row { display: flex; justify-content: space-between; align-items: center; }
.rd-info-l { font-size: 26rpx; color: rgba(255,255,255,0.40); flex-shrink: 0; }
.rd-info-v { font-size: 26rpx; color: #E2E8F0; text-align: right; word-break: break-all; }
.rd-info-highlight { color: #FFB800; font-weight: 600; }

.rd-desc { padding: 8rpx 0; }
.rd-desc text { font-size: 26rpx; color: #E2E8F0; line-height: 1.7; }

.rd-person-flow {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx; padding: 12rpx 0;
}
.rd-person-node { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.rd-person-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; color: #fff;
}
.rd-avatar-reporter { background: linear-gradient(135deg, #006080, #00A8D0); box-shadow: 0 0 16rpx rgba(0,160,210,0.30); }
.rd-avatar-repairer { background: linear-gradient(135deg, #B8860B, #FFB800); box-shadow: 0 0 16rpx rgba(255,184,0,0.30); }
.rd-avatar-completer { background: linear-gradient(135deg, #006B4F, #00E896); box-shadow: 0 0 16rpx rgba(0,232,150,0.30); }
.rd-person-name { font-size: 24rpx; font-weight: 600; color: #E2E8F0; }
.rd-person-role { font-size: 20rpx; color: rgba(255,255,255,0.30); }
.rd-person-arrow { font-size: 28rpx; color: rgba(255,255,255,0.18); margin-top: -16rpx; }

.rd-timeline { display: flex; flex-direction: column; gap: 16rpx; padding-left: 16rpx; border-left: 2rpx solid rgba(255,255,255,0.08); }
.rd-tl-item { display: flex; gap: 16rpx; }
.rd-tl-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #00B4E4; margin-left: -25rpx; margin-top: 8rpx;
  flex-shrink: 0;
}
.rd-tl-body { display: flex; flex-direction: column; gap: 4rpx; }
.rd-tl-time { font-size: 22rpx; color: rgba(255,255,255,0.25); }
.rd-tl-text { font-size: 24rpx; color: #E2E8F0; }
.rd-tl-desc { font-size: 22rpx; color: rgba(255,255,255,0.35); }

.rd-bottom { height: 120rpx; }

.rd-empty { display: flex; flex-direction: column; align-items: center; padding: 200rpx 60rpx; }
.rd-empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.rd-empty-text { font-size: 28rpx; color: rgba(255,255,255,0.25); }
