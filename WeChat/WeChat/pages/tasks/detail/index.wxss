

.page-container { min-height: 100vh; background: var(--color-bg); display: flex; flex-direction: column; }
.detail-scroll { flex: 1; height: 0; padding: 20rpx 24rpx; }

.card {
  padding: 28rpx; margin-bottom: 16rpx;
  background: var(--color-card); border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}
.card-title {
  font-size: 28rpx; font-weight: 700; color: var(--color-primary);
  display: block; margin-bottom: 18rpx; padding-bottom: 14rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.info-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.info-row:not(:last-child) { border-bottom: 1px dashed rgba(255,255,255,0.04); }
.info-l { font-size: 24rpx; color: var(--color-text-placeholder); flex-shrink: 0; }
.info-v { font-size: 26rpx; color: var(--color-text); font-weight: 500; text-align: right; }
.hl  { color: var(--color-primary); font-weight: 700; }
.warn { color: #FF4757; font-weight: 700; }
.fault-text { color: #FF8A92; }

.timeline { padding-left: 8rpx; }
.tl-item { display: flex; gap: 14rpx; padding: 10rpx 0; }
.tl-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; margin-top: 6rpx;
  background: var(--color-primary);
}
.tl-body { flex: 1; }
.tl-time { font-size: 20rpx; color: var(--color-text-placeholder); display: block; }
.tl-text { font-size: 24rpx; color: var(--color-text-secondary); margin-top: 2rpx; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-placeholder); }
