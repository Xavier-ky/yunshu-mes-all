<page-header title="{{pageTitle}}" showBack="{{true}}" />

<view class="page-container">
  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">

        <block wx:if="{{type === 'repair' && data}}">
            <block wx:if="{{data.taskType === 'REPAIR'}}">
        <view class="card">
          <text class="card-title">维修任务</text>
          <view class="info-row"><text class="info-l">任务编号</text><text class="info-v">{{data.taskNo || data.taskId}}</text></view>
          <view class="info-row"><text class="info-l">设备名称</text><text class="info-v">{{data.productName}}</text></view>
          <view class="info-row"><text class="info-l">设备编号</text><text class="info-v">{{data.productModel}}</text></view>
          <view class="info-row"><text class="info-l">所属工位</text><text class="info-v">{{data.workstationName || '--'}}</text></view>
          <view class="info-row"><text class="info-l">当前状态</text><view class="info-v"><status-tag status="{{data.status}}">{{data.statusLabel}}</status-tag></view></view>
          <view class="info-row" wx:if="{{data.description}}"><text class="info-l">故障描述</text><text class="info-v fault-text">{{data.description}}</text></view>
        </view>
        <view class="card">
          <text class="card-title">人员信息</text>
          <view class="info-row"><text class="info-l">上报人</text><text class="info-v">{{data.reportedBy || '--'}}</text></view>
          <view class="info-row"><text class="info-l">维修员</text><text class="info-v">{{data.assignedTo || '--'}}</text></view>
          <view class="info-row" wx:if="{{data.completedBy}}"><text class="info-l">完成人</text><text class="info-v">{{data.completedBy}}</text></view>
        </view>
      </block>
            <block wx:else>
        <view class="card">
          <text class="card-title">设备信息</text>
          <view class="info-row"><text class="info-l">设备编号</text><text class="info-v">{{data.deviceCode}}</text></view>
          <view class="info-row"><text class="info-l">设备名称</text><text class="info-v">{{data.deviceName}}</text></view>
          <view class="info-row"><text class="info-l">所属产线</text><text class="info-v">{{data.lineName}}</text></view>
          <view class="info-row"><text class="info-l">当前状态</text><view class="info-v"><status-tag status="{{data.status}}">{{data.statusLabel}}</status-tag></view></view>
          <view class="info-row" wx:if="{{data.faultDescription}}"><text class="info-l">故障描述</text><text class="info-v fault-text">{{data.faultDescription}}</text></view>
        </view>
        <view class="card" wx:if="{{data.repairRecords && data.repairRecords.length > 0}}">
          <text class="card-title">维修记录</text>
          <view class="timeline">
            <view class="tl-item" wx:for="{{data.repairRecords}}" wx:key="repairId">
              <view class="tl-dot"></view>
              <view class="tl-body">
                <text class="tl-time">{{item.repairTime}}</text>
                <text class="tl-text">{{item.repairBy}}：{{item.repairResult || '处理中…'}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>

        <block wx:if="{{type === 'material' && data}}">
      <view class="card">
        <text class="card-title">缺料信息</text>
        <view class="info-row"><text class="info-l">物料名称</text><text class="info-v">{{data.materialName}}</text></view>
        <view class="info-row"><text class="info-l">物料编码</text><text class="info-v">{{data.materialCode}}</text></view>
        <view class="info-row"><text class="info-l">需求数量</text><text class="info-v hl">{{data.needQty}}</text></view>
        <view class="info-row"><text class="info-l">剩余库存</text><text class="info-v {{data.remainQty === 0 ? 'warn' : ''}}">{{data.remainQty}}</text></view>
        <view class="info-row"><text class="info-l">紧急程度</text><text class="info-v {{data.urgency === 'URGENT' ? 'warn' : ''}}">{{data.urgencyLabel}}</text></view>
        <view class="info-row"><text class="info-l">当前状态</text><view class="info-v"><status-tag status="{{data.status}}">{{data.statusLabel}}</status-tag></view></view>
      </view>

      <view class="card">
        <text class="card-title">产线信息</text>
        <view class="info-row"><text class="info-l">产线</text><text class="info-v">{{data.lineName}}</text></view>
        <view class="info-row"><text class="info-l">工位</text><text class="info-v">{{data.workstationName}}</text></view>
        <view class="info-row"><text class="info-l">工单号</text><text class="info-v">{{data.workOrderNo}}</text></view>
      </view>

            <view class="card" wx:if="{{data.status === 'PROCESSING' || data.status === 'COMPLETED'}}">
        <text class="card-title">配送进度</text>
        <view class="info-row"><text class="info-l">实发数量</text><text class="info-v hl">{{data.actualQty || '--'}}</text></view>
        <view class="info-row"><text class="info-l">批次号</text><text class="info-v">{{data.batchNo || '--'}}</text></view>
        <view class="info-row" wx:if="{{data.estimatedArrival}}"><text class="info-l">预计送达</text><text class="info-v">{{data.estimatedArrival}}</text></view>
        <view class="info-row" wx:if="{{data.completeTime}}"><text class="info-l">完成时间</text><text class="info-v">{{data.completeTime}}</text></view>
      </view>
    </block>

        <block wx:if="{{type === 'quality' && data}}">
      <view class="card">
        <text class="card-title">任务信息</text>
        <view class="info-row"><text class="info-l">产品名称</text><text class="info-v">{{data.productName}}</text></view>
        <view class="info-row"><text class="info-l">工单号</text><text class="info-v">{{data.workOrderNo}}</text></view>
        <view class="info-row"><text class="info-l">工位</text><text class="info-v">{{data.workstationName}}</text></view>
        <view class="info-row"><text class="info-l">当前状态</text><view class="info-v"><status-tag status="{{data.status}}">{{data.statusLabel}}</status-tag></view></view>
      </view>

      <view class="card">
        <text class="card-title">检验进度</text>
        <view class="info-row"><text class="info-l">计划数量</text><text class="info-v">{{data.planQty}}</text></view>
        <view class="info-row"><text class="info-l">已完成</text><text class="info-v hl">{{data.completedQty || 0}}</text></view>
        <view class="info-row"><text class="info-l">剩余</text><text class="info-v">{{data.planQty - (data.completedQty || 0)}}</text></view>
      </view>
    </block>

        <view class="empty" wx:if="{{!data}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">未找到相关数据</text>
    </view>

  </scroll-view>
</view>
<action-footer
  wx:if="{{data && !upgraded}}"
  primaryText="⚠️ 升级为安灯事件"
  secondaryText="返回"
  bind:primary="onUpgrade"
  bind:secondary="onBack"
/>
