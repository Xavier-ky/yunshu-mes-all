

.tab-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex;
  background: rgba(10,22,40,0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(255,255,255,0.06);
  z-index: 999;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 8rpx 0 10rpx;
  transition: all 0.2s ease;
}
.tab-item:active { opacity: 0.7; }

.tab-icon-wrap { position: relative; margin-bottom: 2rpx; }
.tab-icon { font-size: 48rpx; opacity: 0.55; transition: all 0.2s ease; }
.tab-icon-img { width: 48rpx; height: 48rpx; opacity: 0.55; transition: all 0.2s ease; }
.tab-active .tab-icon { opacity: 1; }
.tab-active .tab-icon-img { opacity: 1; }

.tab-badge {
  position: absolute; top: -4rpx; right: -14rpx;
  min-width: 16rpx; height: 30rpx; line-height: 30rpx;
  border-radius: 15rpx; padding: 0 10rpx;
  background: #D43040; border: 2rpx solid #0A1628;
  font-size: 18rpx; color: #fff; font-weight: 700;
  text-align: center; white-space: nowrap;
}

.tab-text {
  font-size: 20rpx; font-weight: 500;
  color: rgba(255,255,255,0.35); transition: all 0.2s ease;
}
.tab-text.active { color: #00B4E4; font-weight: 700; }
