
.action-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(10,22,40,0.96);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(255,255,255,0.06);
  z-index: 99;
  gap: 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-footer button {
  border-radius: 12rpx;
  height: 96rpx;
  font-size: 30rpx;
}

.action-footer .btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-footer .btn-default {
  width: 180rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.06) !important;
  color: rgba(255,255,255,0.50) !important;
  border: 1rpx solid rgba(255,255,255,0.10) !important;
  font-weight: 500;
}
.action-footer .btn-default:active {
  background: rgba(255,255,255,0.10) !important;
}

.action-footer .btn-primary {
  background: #00B4E4 !important;
  color: #fff !important;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(0,180,240,0.25);
  font-weight: 600;
}
.action-footer .btn-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}
.action-footer .btn-disabled {
  opacity: 0.4;
  box-shadow: none;
}
