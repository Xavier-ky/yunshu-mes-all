
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  z-index: 999;
  padding-top: 4rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 10rpx;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-indicator {
  position: absolute;
  top: 0;
  width: 24rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 2rpx;
  transition: all 0.25s ease;
  opacity: 0.45;
}

.tab-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 2rpx;
  opacity: 0.45;
}

.tab-item .tab-icon {
  filter: none;
}

.tab-text {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
  transition: all 0.25s ease;
  letter-spacing: 0.5rpx;
}

.tab-text.active {
  color: var(--color-primary);
  font-weight: 600;
}
