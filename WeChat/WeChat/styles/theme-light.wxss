

.theme-light .page-container,
.theme-light .andon-content,
.theme-light .db-content,
.theme-light .mc-content,
.theme-light .page-content { background: #f0f2f5 !important; }

.theme-light .card,
.theme-light .ac-card,
.theme-light .mc-card,
.theme-light .ac-related,
.theme-light .kpi-card,
.theme-light .chart-card,
.theme-light .line-card { background: #fff !important; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04) !important; }
.theme-light .ac-related { background: #f0f7fa !important; border-color: #d0e4f0 !important; }

.theme-light .section-title,
.theme-light .chart-title,
