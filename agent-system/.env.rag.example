# FastAPI RAG adapter configuration. Copy these values into backend/.env when enabling RAG.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=mes_knowledge_v1
RAG_EMBEDDING_DIMENSIONS=512
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_MODEL_PATH=../mymodel/models/bge-small-zh-v1.5
RAG_EMBEDDING_BATCH_SIZE=8
