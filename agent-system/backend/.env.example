ENABLE_MOCK_TOOLS=true
MOCK_LLM=false
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# 阿里通义千问（OpenAI 兼容）
QWEN_API_KEY=
QWEN_BASE_URL=https://ws-9ket38qehg8899i8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max

# 智谱 GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

SPRING_BOOT_BASE_URL=http://127.0.0.1:8080
AGENT_CORS_ORIGINS=http://127.0.0.1:5173

# Companion security and fallback behaviour
COMPANION_JWT_ENFORCE=true
JWT_SECRET=yunshu-mes-dev-jwt-secret-key-please-change-in-production-2026
COMPANION_REQUEST_TIMEOUT_SECONDS=4

# Local Qwen3-0.6B companion brain
LOCAL_QWEN_ENABLED=true
LOCAL_QWEN_MODEL_PATH=../mymodel/models/Qwen3-0.6B
LOCAL_QWEN_MAX_NEW_TOKENS=384
LOCAL_QWEN_MAX_HISTORY_TURNS=6
LOCAL_QWEN_TEMPERATURE=0.3
LOCAL_QWEN_EAGER_LOAD=false

# Fine-tuned Qwen3L companion brain. It is loaded lazily on its first selected chat.
LOCAL_QWENL_ENABLED=true
LOCAL_QWENL_MODEL_PATH=../mymodel/models/Qwen3-0.6B-MES-clean360-balanced-merged
LOCAL_QWENL_MAX_NEW_TOKENS=384
LOCAL_QWENL_EAGER_LOAD=false

# The existing MES database: chat sessions and every user/assistant message are stored here.
AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=3306
AGENT_DB_NAME=fan_mes
AGENT_DB_USER=root
AGENT_DB_PASSWORD=

# Local Qdrant RAG index (started by ../docker-compose.rag.yml)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=mes_knowledge_v1
RAG_EMBEDDING_DIMENSIONS=512
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_MODEL_PATH=../mymodel/models/bge-small-zh-v1.5
RAG_EMBEDDING_BATCH_SIZE=8
